---
import SectionAnchor from './SectionAnchor.astro';
import ChapterMarker from './ChapterMarker.astro';
import WorkCard from './WorkCard.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  {
    num: '01', eyebrow: 'Fintech · KYC · Onboarding',
    title: 'Tagliare metà onboarding invece di rifarlo.',
    description: '−40% drop-off in 8 settimane su un flusso B2B a 6 step. Tolti 3, non rifatti gli altri.',
    meta: '2024 · Senior UX',
    href: `${base}/case-study`, color: 1 as const,
  },
  {
    num: '02', eyebrow: '[Settore · Dominio · Tipo]',
    title: '[Titolo che nomina la decisione, non il prodotto.]',
    description: '[Una riga: cosa era in gioco, cosa è cambiato dopo.]',
    meta: '[Anno] · [Ruolo]',
    href: '#', color: 2 as const, disabled: true,
  },
  {
    num: '03', eyebrow: '[Settore] · Su richiesta',
    title: '[Terzo progetto — o caso NDA mostrato in colloquio.]',
    description: '[Una riga sintetica. Se NDA, spiega cosa puoi mostrare a voce.]',
    meta: '[Anno] · Su richiesta',
    href: '#', color: 3 as const, disabled: true,
  },
];
---
<section class="bg-bg pb-20 md:pb-28" id="work" aria-labelledby="work-anchor">
  <ChapterMarker chapter="III" label="Progetti" />
  <div class="container-editorial">

    <SectionAnchor
      chapter="III"
      label="Progetti"
      verb="Progetto."
      subtitle="Tre modi di lavorare su un problema, non tre schermate."
    />

    <ol class="list-none p-0 m-0 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((p, i) => (
        <li class="flex" data-reveal style={`--reveal-delay: ${i + 1};`}>
          <WorkCard {...p} />
        </li>
      ))}
    </ol>
  </div>
</section>
