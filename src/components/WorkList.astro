---
import { projects } from '@/data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="bg-bg pb-20 md:pb-28" id="work" aria-labelledby="work-anchor">
  <div class="container-editorial">

    <header class="pt-8 md:pt-12 pb-8 md:pb-10 mb-10 md:mb-14 border-b border-border">
      <p class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 mb-6 md:mb-8" data-reveal>
        <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
        <span class="tabular-nums">III</span>
        <span aria-hidden="true" class="opacity-40">—</span>
        <span>Progetti</span>
      </p>
      <h2
        id="work-anchor"
        class="font-body font-black leading-[0.98] m-0 text-fg max-w-[20ch]"
        style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.035em;"
        data-reveal
      >
        Progetti scelti per <span class="font-display italic font-light text-accent">decisione</span>, non per output.
      </h2>
    </header>

    <ul class="list-none p-0 m-0 flex flex-col gap-6 md:gap-8">
      {projects.map((p) => {
        const dark = !!p.onSignatureDark;
        return (
          <li>
            <a
              href={`${base}/work/${p.slug}/`}
              class:list={[
                'group relative block overflow-hidden no-underline min-h-[280px] md:min-h-[320px] p-8 md:p-10',
                'transition-transform duration-300 ease-editorial hover:-translate-y-1',
              ]}
              style={`background-color: ${p.signatureColor}; color: ${dark ? '#0A0A0A' : '#FFFFFF'};`}
              data-cursor-label="Leggi il case study"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-2 -bottom-10 font-display italic font-light leading-[0.8] tracking-tighter z-0 transition-opacity duration-300 ease-editorial"
                style={`font-size: clamp(12rem, 22vw, 20rem); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-variant-numeric: tabular-nums; opacity: ${dark ? '0.12' : '0.14'};`}
              >{p.num}</span>

              <div class="relative z-10 grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 md:gap-12 h-full">
                <div class="flex flex-col">
                  <p
                    class:list={[
                      'text-[0.72rem] uppercase tracking-[0.14em] font-medium m-0 mb-4',
                      dark ? 'opacity-70' : 'opacity-80',
                    ]}
                  >{p.eyebrow}</p>
                  <h3
                    class="font-body font-black leading-[1.02] tracking-tight m-0 mb-4"
                    style="font-size: clamp(1.75rem, 3.6vw, 3rem); letter-spacing: -0.03em;"
                  >{p.title}</h3>
                  <p
                    class:list={[
                      'text-step-0 leading-[1.5] max-w-[52ch] m-0',
                      dark ? 'opacity-80' : 'opacity-85',
                    ]}
                  >{p.lede}</p>
                </div>

                <div class="flex flex-col justify-between items-start md:items-end gap-8">
                  <div class="text-right md:text-right">
                    <p
                      class="font-body font-black leading-none tracking-tight m-0 tabular-nums"
                      style="font-size: clamp(3rem, 5.5vw, 4.5rem); letter-spacing: -0.035em;"
                    >{p.metric.value}</p>
                    <p
                      class:list={[
                        'font-mono text-[0.68rem] tracking-[0.06em] max-w-[18ch] mt-2 ml-auto m-0',
                        dark ? 'opacity-70' : 'opacity-80',
                      ]}
                    >{p.metric.label}</p>
                  </div>

                  <div class:list={[
                    'inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-[0.14em] font-medium',
                    dark ? 'opacity-90' : 'opacity-95',
                  ]}>
                    <span>{p.client} · {p.year}</span>
                    <span
                      aria-hidden="true"
                      class="inline-flex items-center justify-center w-11 h-11 rounded-full border transition-transform duration-300 ease-editorial group-hover:translate-x-1"
                      style={`border-color: ${dark ? 'rgba(10,10,10,0.4)' : 'rgba(255,255,255,0.5)'};`}
                    >
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

  </div>
</section>
