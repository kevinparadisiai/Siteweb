---
// V2Footer — minimalissimo. Il grosso del contatto vive in
// ContactBlock (dark). Qui solo una barra copyright.
const year = new Date().getFullYear();
---
<footer class="v2-footer">
  <div class="v2-footer__shell">
    <span class="v2-footer__copy mono">© {year} Kevin Paradisi <span aria-hidden="true">·</span> Milano, EU</span>
    <span class="v2-footer__made mono">Costruito con cura, senza template.</span>
  </div>
</footer>

<style>
  .v2-footer {
    background: var(--ink);
    color: color-mix(in srgb, var(--paper) 45%, transparent);
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--paper) 12%, transparent);
  }
  .v2-footer__shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .v2-footer__copy,
  .v2-footer__made {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
  .v2-footer__copy span[aria-hidden="true"] { margin: 0 0.4rem; opacity: 0.55; }

  @media (max-width: 560px) {
    .v2-footer__made { display: none; }
  }
</style>
