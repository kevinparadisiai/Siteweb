---
// HeroReveal — classic slideshow: one phrase visible at a time. The
// previous one slides up + fades out at the same moment the new one
// slides in from below + fades in. Auto-plays on landing (2.5s per
// slide). First scroll skips to the finale so the projects below are
// reachable. Pulsing asterisk mark above the phrase area signals
// animation activity.
const phases: string[][] = [
  ['Sette', 'anni', 'tra', 'prodotto', 'e', 'servizi', 'digitali.'],
  ['Framing,', 'sistemi,', 'outcome', 'misurabili.'],
  ['Sposto', 'il', 'focus', 'verso', 'design', 'strategy.'],
];
const finale: string[] = ['Progetto', 'sistemi,', 'non', 'schermate.'];
---
<section
  id="hero"
  class="hero-auto relative bg-bg h-dvh flex items-center overflow-hidden"
  aria-labelledby="hero-title"
>
  <div class="container-editorial relative w-full pl-[5rem] md:pl-[10rem]">

    <!-- Pulsing signature mark just above the phrase — sits inside the
         main content column so it doesn't collide with the sidebar nav. -->
    <span class="hero-auto__mark" aria-hidden="true" data-animation-mark>
      <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor">
        <path d="M14 0h4v13.2l9.3-4.6 2 3.5-9.3 4.6 9.3 4.6-2 3.5-9.3-4.6V32h-4V18.8L4.7 23.4l-2-3.5 9.3-4.6-9.3-4.6 2-3.5L14 12z"/>
      </svg>
    </span>

    <!-- Slot: exactly one phrase visible at any moment. Each phrase
         reveals its words with a staggered timing so the reader
         actually reads it left-to-right, not all-at-once. -->
    <div class="hero-auto__slot" role="region" aria-live="polite" aria-atomic="true">
      {phases.map((words, i) => (
        <p
          class="hero-phase"
          data-phase={i}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          {words.map((w, j) => (
            <span class="hero-word" style={`--i:${j};`}>{w}</span>
          ))}
        </p>
      ))}
      <h1
        id="hero-title"
        class="hero-phase hero-phase--finale"
        data-phase={phases.length}
        aria-hidden="true"
      >
        {finale.map((w, j) => {
          const italic = /^sistemi/i.test(w);
          return (
            <span
              class:list={['hero-word', italic && 'font-display italic font-light text-accent']}
              style={`--i:${j};`}
            >{w}</span>
          );
        })}
      </h1>
    </div>

  </div>
</section>

<style>
  .hero-auto__mark {
    display: inline-block;
    color: theme('colors.fg');
    line-height: 0;
    margin-bottom: 1.5rem;
    animation: hero-mark-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hero-mark-pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.10); }
  }
  .hero-auto__mark.is-done { animation: none; opacity: 0.45; }

  /* Slot: fixed-height area with absolutely-stacked phrases — only one
     is visible at a time (opacity + translate transitions). */
  .hero-auto__slot {
    position: relative;
    min-height: clamp(11rem, 26vh, 20rem);
  }

  .hero-phase {
    position: absolute;
    top: 0; left: 0; right: 0;
    margin: 0;
    max-width: 22ch;
    /* SAME font / size / weight for EVERY phase (including finale) */
    font-family: theme('fontFamily.body');
    font-weight: 700;
    font-size: clamp(2.5rem, 5.8vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: #0A0A0A;
    /* Phrase container fades in/out as a whole for entry/exit direction. */
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 320ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 420ms cubic-bezier(0.2, 0.6, 0.2, 1);
    pointer-events: none;
  }
  .hero-phase.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .hero-phase.is-past {
    opacity: 0;
    transform: translateY(-28px);
  }

  /* Word-by-word reveal — each word slides in from below with a
     staggered delay driven by --i, giving a real reading rhythm. */
  .hero-word {
    display: inline-block;
    /* margin-right acts as the inter-word space independent of flex/whitespace */
    margin-right: 0.28em;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 440ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 520ms cubic-bezier(0.2, 0.6, 0.2, 1);
    will-change: opacity, transform;
  }
  .hero-phase.is-active .hero-word {
    opacity: 1;
    transform: translateY(0);
    /* per-word stagger: 100ms per word */
    transition-delay: calc(var(--i, 0) * 100ms);
  }
  .hero-phase.is-past .hero-word {
    /* leave together, no stagger on exit — feels snappier */
    opacity: 0;
    transform: translateY(-16px);
    transition-delay: 0ms;
  }

  /* Finale keeps the italic accent color even during transitions */
  .hero-phase--finale .text-accent { color: theme('colors.accent'); }

  @media (prefers-reduced-motion: reduce) {
    .hero-auto__mark { animation: none; opacity: 0.45; }
    .hero-phase, .hero-word { transition: none; }
    .hero-phase.is-active .hero-word { transition-delay: 0ms; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phases = Array.from(document.querySelectorAll<HTMLElement>('.hero-phase'));
  const mark = document.querySelector<HTMLElement>('[data-animation-mark]');

  const root = document.documentElement;

  const finishAnimation = () => {
    if (mark) mark.classList.add('is-done');
    root.classList.remove('hero-animating');
  };

  const setActive = (i: number) => {
    phases.forEach((p, j) => {
      p.classList.remove('is-active', 'is-past');
      if (j === i) {
        p.classList.add('is-active');
        p.removeAttribute('aria-hidden');
      } else if (j < i) {
        p.classList.add('is-past');
        p.setAttribute('aria-hidden', 'true');
      } else {
        p.setAttribute('aria-hidden', 'true');
      }
    });
    if (i >= phases.length - 1) finishAnimation();
  };

  if (phases.length > 0) {
    if (reduce) {
      // Reduced motion: no sequence at all, jump to finale and let the
      // hero-nav appear immediately.
      setActive(phases.length - 1);
    } else {
      // While the sequence is playing, hide the hero-nav sidebar so it
      // doesn't sit under the pulsing mark. Removed on finish / scroll.
      root.classList.add('hero-animating');

      const PHASE_MS = 2900;
      let idx = 0;
      setActive(0);
      let timer: number | null = window.setInterval(() => {
        idx += 1;
        if (idx >= phases.length) {
          if (timer) { window.clearInterval(timer); timer = null; }
          return;
        }
        setActive(idx);
      }, PHASE_MS);

      const onScroll = () => {
        if (window.scrollY <= 40) return;
        if (idx < phases.length - 1) {
          if (timer) { window.clearInterval(timer); timer = null; }
          idx = phases.length - 1;
          setActive(idx);
        }
        window.removeEventListener('scroll', onScroll);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
