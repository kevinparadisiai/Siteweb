---
// HeroReveal — Sketchin-style reading sequence.
// Phrases share the same font/size — only color changes. The current
// phrase is black, the previous one fades to gray and floats up
// briefly during the transition, giving a reading rhythm. First
// scroll skips to the finale so the projects below are reachable.
// Adds a persistent "Kevin." wordmark on the left of the stage as
// the animation's brand signal (Sketchin uses their asterisk logo).
const phases: string[][] = [
  ['Sette', 'anni', 'tra', 'prodotto', 'e', 'servizi', 'digitali.'],
  ['Framing,', 'sistemi,', 'outcome', 'misurabili.'],
  ['Sposto', 'il', 'focus', 'verso', 'design', 'strategy.'],
];
const finale: string[] = ['Progetto', 'sistemi,', 'non', 'schermate.'];
---
<section
  id="hero"
  class="hero-auto relative bg-bg min-h-dvh overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- Persistent brand mark, left of the stage, marks the animation. -->
  <a
    href="#hero"
    class="hero-auto__brand"
    aria-label="Kevin Paradisi"
  >
    <span aria-hidden="true">Kevin<em>.</em></span>
  </a>

  <div class="container-editorial relative h-dvh flex items-center">

    <div class="hero-auto__stage relative w-full">
      {phases.map((words, i) => (
        <p
          class="hero-phase"
          data-phase={i}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <span class="hero-phase__text">
            {words.map((w, j) => (
              <>
                <span class="hero-word">{w}</span>
                {j < words.length - 1 ? ' ' : ''}
              </>
            ))}
          </span>
        </p>
      ))}

      <!-- Finale: same font/size as the phases, just the italic accent
           on "sistemi," survives -->
      <h1
        id="hero-title"
        class="hero-phase"
        data-phase={phases.length}
        aria-hidden="true"
      >
        <span class="hero-phase__text">
          {finale.map((w, j) => {
            const italic = /^sistemi/i.test(w);
            return (
              <>
                <span class:list={['hero-word', italic && 'font-display italic font-light text-accent']}>{w}</span>
                {j < finale.length - 1 ? ' ' : ''}
              </>
            );
          })}
        </span>
      </h1>
    </div>

  </div>

  <!-- Meta operativa (S4) — bottom of the hero, always visible -->
  <div class="hero-auto__meta container-editorial">
    <p class="font-mono text-[0.72rem] tracking-[0.14em] uppercase text-muted flex flex-wrap gap-x-6 gap-y-2 m-0 max-w-[70ch]">
      <span><span class="text-accent mr-1">◦</span>Disponibile da settembre</span>
      <span><span class="text-accent mr-1">◦</span>Telco · Utilities · Fintech · SaaS B2B</span>
      <span><span class="text-accent mr-1">◦</span>Remoto o Milano</span>
    </p>
  </div>
</section>

<style>
  /* Persistent brand mark on the left of the animation stage */
  .hero-auto__brand {
    position: absolute;
    top: 50%;
    left: clamp(1rem, 4vw, 2.5rem);
    transform: translateY(-50%);
    z-index: 3;
    font-family: theme('fontFamily.display');
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: theme('colors.fg');
    text-decoration: none;
  }
  .hero-auto__brand em {
    color: theme('colors.accent');
    font-style: normal;
  }
  @media (min-width: 900px) {
    .hero-auto__brand { font-size: 1.6rem; }
  }

  .hero-auto__meta {
    position: absolute;
    left: 0; right: 0; bottom: 2rem;
    z-index: 3;
  }

  /* Stage — reserves enough vertical room for the tallest phrase */
  .hero-auto__stage { min-height: 60vh; padding-left: 5rem; }
  @media (min-width: 900px) { .hero-auto__stage { padding-left: 8rem; } }

  /* Phrases stacked absolutely in the same spot; transitions crossfade
     via opacity + a small vertical drift so the past phrase floats up
     while the next one appears from below. */
  .hero-phase {
    position: absolute;
    top: 0; left: 0; right: 0;
    margin: 0;
    display: block;
    /* SAME font/size for ALL phases (phases + finale) — Sketchin rule */
    font-family: theme('fontFamily.body');
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgba(10, 10, 10, 0.25); /* gray = past / not-yet-active */
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 620ms cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1),
      color 500ms cubic-bezier(0.2, 0.6, 0.2, 1);
    will-change: opacity, transform, color;
  }
  .hero-phase__text {
    display: block;
    max-width: 22ch;
  }
  .hero-word {
    display: inline;
  }

  /* Current phrase — black, in place, fully visible */
  .hero-phase.is-active {
    opacity: 1;
    color: #0A0A0A;
    transform: translateY(0);
  }
  /* Previous phrase — visible in gray, drifted up */
  .hero-phase.is-past {
    opacity: 1;
    color: rgba(10, 10, 10, 0.28);
    transform: translateY(-32px);
  }
  /* Older phrases — hidden */
  .hero-phase.is-done {
    opacity: 0;
    transform: translateY(-64px);
  }

  /* Preserve accent color even when the phrase is muted */
  .hero-phase .text-accent { color: theme('colors.accent') !important; }

  @media (prefers-reduced-motion: reduce) {
    .hero-phase { transition: none; }
    .hero-phase.is-active, .hero-phase.is-past, .hero-phase.is-done {
      transition: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phases = Array.from(document.querySelectorAll<HTMLElement>('.hero-phase'));

  const setState = (activeIdx: number) => {
    phases.forEach((p, j) => {
      p.classList.remove('is-active', 'is-past', 'is-done');
      if (j < activeIdx - 1) p.classList.add('is-done');
      else if (j === activeIdx - 1) p.classList.add('is-past');
      else if (j === activeIdx) p.classList.add('is-active');
      // future phases: keep default (invisible, waiting)
      if (j === activeIdx) p.removeAttribute('aria-hidden');
      else p.setAttribute('aria-hidden', 'true');
    });
  };

  if (phases.length > 0) {
    if (reduce) {
      // Show the finale immediately for reduced-motion users
      setState(phases.length - 1);
    } else {
      const PHASE_MS = 2600;
      let idx = 0;
      setState(0);
      let timer: number | null = window.setInterval(() => {
        idx += 1;
        if (idx >= phases.length) {
          if (timer) { window.clearInterval(timer); timer = null; }
          return;
        }
        setState(idx);
      }, PHASE_MS);

      // First real scroll skips the sequence to the finale so the
      // projects below are reachable without waiting the animation out.
      const onScroll = () => {
        if (window.scrollY <= 40) return;
        if (idx < phases.length - 1) {
          if (timer) { window.clearInterval(timer); timer = null; }
          idx = phases.length - 1;
          setState(idx);
        }
        window.removeEventListener('scroll', onScroll);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
