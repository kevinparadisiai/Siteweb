---
// HeroReveal — unified hero: one passage that starts with the manifesto
// and ends with the finale statement. Scroll-linked word reveal on all of
// it. No side mark, no separate accent screen — everything on white bg.
const passage =
  `Sette anni tra prodotto e servizi digitali. ` +
  `Framing, sistemi, outcome misurabili. ` +
  `Sposto il focus verso design strategy. ` +
  `Progetto sistemi, non schermate.`;
const words = passage.split(/\s+/);
---
<section
  id="hero"
  class="relative bg-bg min-h-dvh flex items-center overflow-hidden"
  aria-labelledby="hero-title"
>
  <div class="container-editorial relative z-0 py-24 md:py-32">
    <h1
      id="hero-title"
      class="hero-reveal__passage font-body font-medium leading-[1.1] m-0 max-w-[22ch] text-fg"
      style="letter-spacing: -0.025em;"
      data-reveal-words
    >
      {words.map((w, i, arr) => {
        // Highlight the final sentence typographically: bump weight,
        // and swap "sistemi," to Fraunces italic light as the accent.
        const finaleStart = words.indexOf('Progetto');
        const inFinale = finaleStart >= 0 && i >= finaleStart;
        const isItalicAccent = /^sistemi/i.test(w);
        return (
          <>
            <span
              class:list={[
                'rw-word',
                inFinale && 'font-black',
                isItalicAccent && 'font-display italic font-light text-accent',
              ]}
              style={inFinale ? 'letter-spacing: -0.035em;' : ''}
            >{w}</span>
            {i < arr.length - 1 ? ' ' : ''}
          </>
        );
      })}
    </h1>

    <!-- Meta operativa (S4) as a small caption below the passage -->
    <p class="mt-12 md:mt-16 font-mono text-[0.72rem] tracking-[0.14em] uppercase text-muted flex flex-wrap gap-x-6 gap-y-2 max-w-[70ch]">
      <span><span class="text-accent mr-1">◦</span>Disponibile da settembre</span>
      <span><span class="text-accent mr-1">◦</span>Telco · Utilities · Fintech · SaaS B2B</span>
      <span><span class="text-accent mr-1">◦</span>Remoto o Milano</span>
    </p>
  </div>
</section>

<style>
  .hero-reveal__passage {
    font-size: clamp(2rem, 4.6vw, 4rem);
  }
</style>
