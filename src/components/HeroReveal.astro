---
// HeroReveal — Sketchin reading-rail pattern.
// The phrases are stacked vertically. The container translates upward
// by one phrase per step, so the current phrase always sits in the
// middle of the viewport while the previous one stays visible above
// in gray. Plain-string phrases keep native whitespace between words.
// A small pulsing mark on the left signals "this area is animating"
// (replaces the static "Kevin." wordmark that read like a logo, not
// like a loading indicator).
const phases: string[] = [
  'Sette anni tra prodotto e servizi digitali.',
  'Framing, sistemi, outcome misurabili.',
  'Sposto il focus verso design strategy.',
  // Finale is the last phrase, gets italic accent on "sistemi,"
];
---
<section
  id="hero"
  class="hero-auto relative bg-bg h-dvh overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- Pulsing signature mark, left of the rail. Signals animation. -->
  <span
    class="hero-auto__mark"
    aria-hidden="true"
    data-animation-mark
  >
    <svg viewBox="0 0 32 32" width="34" height="34" fill="currentColor">
      <path d="M14 0h4v13.2l9.3-4.6 2 3.5-9.3 4.6 9.3 4.6-2 3.5-9.3-4.6V32h-4V18.8L4.7 23.4l-2-3.5 9.3-4.6-9.3-4.6 2-3.5L14 12z"/>
    </svg>
  </span>

  <div class="hero-auto__viewport">
    <div class="hero-auto__rail" style="--idx: 0;">

      {phases.map((text, i) => (
        <p
          class="hero-phase"
          data-phase={i}
          aria-hidden={i === 0 ? undefined : 'true'}
        >{text}</p>
      ))}

      <h1
        id="hero-title"
        class="hero-phase hero-phase--finale"
        data-phase={phases.length}
        aria-hidden="true"
      >Progetto <span class="font-display italic font-light text-accent">sistemi,</span> non schermate.</h1>

    </div>
  </div>

  <!-- Meta operativa (S4) — bottom of hero, always visible -->
  <div class="hero-auto__meta container-editorial">
    <p class="font-mono text-[0.72rem] tracking-[0.14em] uppercase text-muted flex flex-wrap gap-x-6 gap-y-2 m-0 max-w-[70ch]">
      <span><span class="text-accent mr-1">◦</span>Disponibile da settembre</span>
      <span><span class="text-accent mr-1">◦</span>Telco · Utilities · Fintech · SaaS B2B</span>
      <span><span class="text-accent mr-1">◦</span>Remoto o Milano</span>
    </p>
  </div>
</section>

<style>
  /* Pulsing animation mark on the left */
  .hero-auto__mark {
    position: absolute;
    top: 50%;
    left: clamp(1rem, 4vw, 2.5rem);
    transform: translateY(-50%);
    z-index: 3;
    color: theme('colors.fg');
    display: inline-flex;
    line-height: 0;
    animation: hero-mark-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hero-mark-pulse {
    0%, 100% { opacity: 0.35; transform: translateY(-50%) scale(1); }
    50%      { opacity: 1;    transform: translateY(-50%) scale(1.08); }
  }
  .hero-auto__mark.is-done { animation: none; opacity: 0.5; }

  .hero-auto__meta {
    position: absolute;
    left: 0; right: 0; bottom: 2rem;
    z-index: 3;
  }

  /* Viewport: masks the rail so only one "slot" is visible at a time. */
  .hero-auto__viewport {
    position: absolute;
    inset: 0;
    padding-left: clamp(4.5rem, 8vw, 8rem);
    padding-right: clamp(1rem, 4vw, 2.5rem);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* Rail: vertical stack of phrases. Translates up by one PHASE_HEIGHT
     per step, so the active phrase lands in view and the previous one
     drifts up to the top. */
  .hero-auto__rail {
    --phase-h: clamp(9rem, 20vh, 16rem);
    position: relative;
    width: 100%;
    transform: translateY(calc(var(--idx, 0) * (-1 * var(--phase-h))));
    transition: transform 780ms cubic-bezier(0.6, 0.02, 0.2, 1);
  }

  .hero-phase {
    margin: 0;
    padding: 0;
    min-height: var(--phase-h);
    display: flex;
    align-items: center;
    max-width: 22ch;
    /* SAME font/size for every phase — Sketchin rule */
    font-family: theme('fontFamily.body');
    font-weight: 700;
    font-size: clamp(2.5rem, 5.8vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: rgba(10, 10, 10, 0.28); /* default: gray = past or upcoming */
    transition: color 500ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .hero-phase.is-active { color: #0A0A0A; }
  .hero-phase--finale .text-accent { color: theme('colors.accent'); }

  @media (prefers-reduced-motion: reduce) {
    .hero-auto__mark { animation: none; opacity: 0.5; }
    .hero-auto__rail { transition: none; }
    .hero-phase { transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rail = document.querySelector<HTMLElement>('.hero-auto__rail');
  const phases = Array.from(document.querySelectorAll<HTMLElement>('.hero-phase'));
  const mark = document.querySelector<HTMLElement>('[data-animation-mark]');

  const setActive = (i: number) => {
    if (!rail) return;
    rail.style.setProperty('--idx', String(i));
    phases.forEach((p, j) => {
      p.classList.toggle('is-active', j === i);
      if (j === i) p.removeAttribute('aria-hidden');
      else p.setAttribute('aria-hidden', 'true');
    });
    // Signal end of animation
    if (i >= phases.length - 1 && mark) mark.classList.add('is-done');
  };

  if (phases.length > 0) {
    if (reduce) {
      setActive(phases.length - 1);
    } else {
      const PHASE_MS = 2500;
      let idx = 0;
      setActive(0);
      let timer: number | null = window.setInterval(() => {
        idx += 1;
        if (idx >= phases.length) {
          if (timer) { window.clearInterval(timer); timer = null; }
          return;
        }
        setActive(idx);
      }, PHASE_MS);

      // First real scroll → snap to finale so the next block is
      // immediately reachable without waiting the sequence out.
      const onScroll = () => {
        if (window.scrollY <= 40) return;
        if (idx < phases.length - 1) {
          if (timer) { window.clearInterval(timer); timer = null; }
          idx = phases.length - 1;
          setActive(idx);
        }
        window.removeEventListener('scroll', onScroll);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
