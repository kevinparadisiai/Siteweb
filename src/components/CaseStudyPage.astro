---
import Base from '@/layouts/Base.astro';
import SiteSidebar from '@/components/SiteSidebar.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import FeatureHero from '@/components/FeatureHero.astro';
import MockupBrowser from '@/components/MockupBrowser.astro';
import type { Project } from '@/data/projects';

interface Props { project: Project; }
const { project } = Astro.props;

const crumb = `Portfolio / Work / ${project.client}`;
---
<Base title={`${project.client} — ${project.title.replace(/\.$/, '')}`}>
  <SiteSidebar slot="sidebar" current="work" />

  <FeatureHero
    crumb={crumb}
    glyph={project.num}
    title={project.title}
    titleEmWord={project.titleEmWord}
    lede={project.lede}
    signatureColor={project.signatureColor}
    onSignatureDark={project.onSignatureDark}
  />

  <!-- Meta block: Servizi / Cliente / Industria / Anno (Sketchin pattern) -->
  <section
    class="border-b border-border py-12 md:py-16 bg-bg"
    aria-label="Meta progetto"
  >
    <div class="container-editorial grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6">
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.16em] font-medium text-muted mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
          Servizi
        </p>
        <p class="font-body text-step-0 text-fg m-0 leading-tight">
          {project.services.map((s, i) => (
            <span>{s}{i < project.services.length - 1 ? ', ' : ''}</span>
          ))}
        </p>
      </div>
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.16em] font-medium text-muted mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
          Cliente
        </p>
        <p class="font-body font-medium text-step-0 text-fg m-0 leading-tight">{project.client}</p>
      </div>
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.16em] font-medium text-muted mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
          Industria
        </p>
        <p class="font-body text-step-0 text-fg m-0 leading-tight">{project.sector}</p>
      </div>
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.16em] font-medium text-muted mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
          Anno
        </p>
        <p class="font-body text-step-0 text-fg m-0 leading-tight tabular-nums">{project.year}</p>
      </div>
    </div>
  </section>

  <!-- Intro: title left, paragraphs right -->
  <section class="container-editorial py-16 md:py-24" aria-labelledby="intro-anchor">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16">
      <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
        <span class="inline-block w-10 h-px" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
        Il progetto
      </p>
      <div id="intro-anchor" class="text-step-0 md:text-step-1 leading-[1.6] text-fg max-w-[62ch]">
        {project.intro.map((p, i) => (
          <p class:list={[i < project.intro.length - 1 ? 'mb-5' : 'mb-0']}>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Cover mockup: dynamic composition — big browser tilted left, optional
       phone-style detail floating on top-right at an opposing tilt. -->
  {project.cover && (
    <section class="container-editorial pb-24 md:pb-32 overflow-visible" aria-label="Anteprima progetto">
      <div class="relative">
        <div class="md:-mr-16 lg:-mr-24 md:-rotate-[1deg] transition-transform duration-500">
          <MockupBrowser
            signatureColor={project.signatureColor}
            dark={!!project.onSignatureDark}
            caption={project.cover.caption}
            urlHint={project.cover.urlHint}
            variant={project.cover.variant}
            shape={project.cover.shape}
            alt={`Placeholder — ${project.cover.caption}. Mockup di anteprima; l'immagine reale del progetto è NDA.`}
          />
        </div>
        {project.gallery && project.gallery[1] && (
          <div
            aria-hidden="true"
            class="hidden lg:block absolute right-0 -bottom-24 w-[220px] rotate-[3deg] pointer-events-none"
          >
            <MockupBrowser
              signatureColor={project.signatureColor}
              dark={!!project.onSignatureDark}
              variant={project.gallery[1].variant}
              shape="portrait"
              alt=""
            />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Outcome / Risultati — griglia di numeri con trattamento uniforme -->
  <section
    class="border-y border-border py-20 md:py-28 bg-bg"
    aria-labelledby="outcome-anchor"
  >
    <div class="container-editorial">
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16 mb-14 md:mb-20">
        <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
          <span class="inline-block w-10 h-px" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
          Risultati
        </p>
        <h2
          id="outcome-anchor"
          class="font-body font-black text-fg m-0"
          style="font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;"
        >Cosa è successo dopo il rilascio</h2>
      </div>

      {(() => {
        const all = [
          { ...project.metric, primary: true },
          ...(project.metricsSecondary || []).map((m) => ({ ...m, primary: false })),
        ];
        const cols = all.length === 1 ? 'md:grid-cols-1'
                    : all.length === 2 ? 'md:grid-cols-2'
                    : all.length === 3 ? 'md:grid-cols-3'
                    : 'md:grid-cols-4';
        return (
          <div class:list={['grid grid-cols-1 gap-y-14 md:gap-y-0 md:divide-x divide-border border-t border-border', cols]}>
            {all.map((m, i) => (
              <div class:list={['flex flex-col justify-between min-h-[220px] md:min-h-[280px] pt-8 md:pt-10 md:pb-2', i > 0 ? 'md:pl-8 lg:pl-12' : 'md:pr-8 lg:pr-12']}>
                <p class="text-[0.68rem] uppercase tracking-[0.16em] font-medium text-muted m-0 flex items-center gap-2">
                  <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full" style={`background:${project.signatureColor};`}></span>
                  {i === 0 ? 'Metrica principale' : `Metrica ${String(i + 1).padStart(2, '0')}`}
                </p>
                <div class="mt-8 md:mt-0">
                  <p
                    class="font-body font-black m-0 leading-none tabular-nums"
                    style={`font-size: ${m.primary ? 'clamp(5rem, 12vw, 10rem)' : 'clamp(3.5rem, 7vw, 6rem)'}; letter-spacing: -0.045em; color: ${m.primary ? project.signatureColor : '#0A0A0A'};`}
                  >{m.value}</p>
                  <p class="mt-4 md:mt-5 text-step-0 leading-[1.35] text-muted max-w-[26ch] m-0">{m.label}</p>
                </div>
              </div>
            ))}
          </div>
        );
      })()}
    </div>
  </section>

  <!-- Phases: two-column, title left / body right, per phase -->
  <section class="container-editorial py-16 md:py-24" aria-label="Processo">
    <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 mb-10 flex items-center gap-3">
      <span class="inline-block w-10 h-px" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
      Il processo
    </p>

    <div class="flex flex-col gap-14 md:gap-20">
      {project.phases.map((phase, i) => (
        <article class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16 border-t border-border pt-10 md:pt-14">
          <div>
            <p
              class="font-mono text-[0.68rem] font-medium tracking-[0.16em] uppercase m-0 mb-4"
              style={`color:${project.signatureColor};`}
            >Fase {String(i + 1).padStart(2, '0')}</p>
            <h3
              class="font-body font-black text-fg m-0"
              style="font-size: clamp(1.75rem, 3.4vw, 2.6rem); letter-spacing: -0.025em; line-height: 1.05;"
            >{phase.title}</h3>
          </div>
          <div class="text-step-0 md:text-step-1 leading-[1.65] text-fg max-w-[62ch]">
            <p class="m-0">{phase.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Detail gallery: smaller mockups showing other views of the product -->
  {project.gallery && project.gallery.length > 0 && (
    <section class="bg-bg py-16 md:py-24 md:pb-40 border-t border-border overflow-hidden" aria-labelledby="gallery-anchor">
      <div class="container-editorial">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16 mb-12">
          <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
            <span class="inline-block w-10 h-px" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
            Dettagli
          </p>
          <h2
            id="gallery-anchor"
            class="font-body font-black text-fg m-0"
            style="font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;"
          >Altre viste della soluzione</h2>
        </div>

        <!-- Bento layout: varied spans + subtle rotations + vertical offsets
             so the mockups read as a composition, not a uniform 3-col grid. -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-x-10 md:gap-y-16 items-start">
          {project.gallery.map((m, i) => {
            // Item 0 → wide left, tilt -1deg
            // Item 1 → tall right (portrait), spans 2 rows, tilt +2deg
            // Item 2 → medium bottom-left with column offset, tilt -1.5deg, pushed down
            const layout = i === 0
              ? 'md:col-span-8 md:-rotate-[1deg] md:origin-top-left'
              : i === 1
              ? 'md:col-span-4 md:row-span-2 md:mt-16 md:rotate-[2deg] md:origin-top'
              : i === 2
              ? 'md:col-span-7 md:col-start-2 md:mt-14 md:-rotate-[1.5deg] md:origin-top-right'
              : 'md:col-span-6';
            return (
              <div class:list={['transition-transform duration-500', layout]}>
                <MockupBrowser
                  signatureColor={project.signatureColor}
                  dark={!!project.onSignatureDark}
                  caption={m.caption}
                  variant={m.variant}
                  shape={m.shape}
                  alt={`Placeholder — ${m.caption}. Mockup di dettaglio, l'immagine reale del progetto è NDA.`}
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Il mio ruolo (box "Il mio ruolo" — strategy S9) -->
  <section
    class="border-t border-border py-16 md:py-24"
    style={`background-color: ${project.signatureColor}0D;`}
    aria-labelledby="ruolo-anchor"
  >
    <div class="container-editorial grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16">
      <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
        <span class="inline-block w-10 h-px" style={`background:${project.signatureColor};`} aria-hidden="true"></span>
        Il mio ruolo
      </p>
      <div>
        <h2
          id="ruolo-anchor"
          class="font-body font-black text-fg m-0 mb-6"
          style="font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;"
        >Cosa ho posseduto</h2>
        <p class="text-step-0 md:text-step-1 leading-[1.65] text-fg max-w-[62ch] m-0">{project.role}</p>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</Base>

<script define:vars={{ signatureColor: project.signatureColor }}>
  // Set the theme-color meta so mobile UI chrome matches the case signature
  const meta = document.createElement('meta');
  meta.name = 'theme-color';
  meta.content = signatureColor;
  document.head.appendChild(meta);
</script>
