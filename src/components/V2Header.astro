---
// V2Header — logo con marca circolare (come ref Damian Watracz) +
// hamburger che apre un menu overlay dark full-screen con
// navigazione tipografica gigante.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props {
  current?: 'home' | 'about' | 'work';
}
const { current = 'home' } = Astro.props;
---
<header class="v2-header v2-shell">
  <a class="v2-header__id" href={`${base}/v2/`} aria-label="Home">
    <span class="v2-header__mark" aria-hidden="true">
      <span class="v2-header__mark-glyph">K</span>
    </span>
    <span class="v2-header__id-text">
      <span class="v2-header__name">Kevin Paradisi</span>
      <span class="v2-header__role">
        UX designer <span class="v2-header__arrow" aria-hidden="true">→</span>
        <span class="sr-only"> verso </span> Design strategy
      </span>
    </span>
  </a>

  <button
    class="v2-header__menu-btn"
    type="button"
    aria-controls="v2-menu"
    aria-expanded="false"
    aria-label="Apri il menu"
    data-menu-toggle
  >
    <span class="v2-header__menu-label">Menu</span>
    <span class="v2-header__menu-icon" aria-hidden="true">
      <span></span><span></span>
    </span>
  </button>
</header>

<!-- Menu overlay — full-screen dark, tipografia gigante -->
<div
  id="v2-menu"
  class="v2-menu"
  role="dialog"
  aria-modal="true"
  aria-labelledby="v2-menu-title"
  aria-hidden="true"
  data-menu-overlay
>
  <div class="v2-menu__shell">
    <p id="v2-menu-title" class="v2-menu__eyebrow mono">
      <span class="v2-menu__eyebrow-dash" aria-hidden="true"></span>
      Navigation
    </p>

    <nav class="v2-menu__nav" aria-label="Navigazione principale">
      <ul class="v2-menu__list">
        <li class="v2-menu__item">
          <a
            href={`${base}/v2/`}
            class:list={['v2-menu__link', current === 'home' && 'is-current']}
            aria-current={current === 'home' ? 'page' : undefined}
          >
            <span class="v2-menu__link-dash" aria-hidden="true"></span>
            prove
          </a>
        </li>
        <li class="v2-menu__item">
          <a
            href={`${base}/v2/about/`}
            class:list={['v2-menu__link', current === 'about' && 'is-current']}
            aria-current={current === 'about' ? 'page' : undefined}
          >
            <span class="v2-menu__link-dash" aria-hidden="true"></span>
            about
          </a>
        </li>
        <li class="v2-menu__item">
          <a href="mailto:kevinparadisiai@gmail.com" class="v2-menu__link">
            <span class="v2-menu__link-dash" aria-hidden="true"></span>
            contact
          </a>
        </li>
        <li class="v2-menu__item">
          <a
            href={`${base}/cv.pdf`}
            download="Kevin-Paradisi-CV.pdf"
            class="v2-menu__link"
          >
            <span class="v2-menu__link-dash" aria-hidden="true"></span>
            cv <span class="v2-menu__link-ext" aria-hidden="true">(pdf)</span>
          </a>
        </li>
        <li class="v2-menu__item">
          <a
            href="https://www.linkedin.com/in/kevinparadisi"
            target="_blank"
            rel="noopener"
            class="v2-menu__link"
          >
            <span class="v2-menu__link-dash" aria-hidden="true"></span>
            linkedin <span class="v2-menu__link-ext" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <p class="v2-menu__foot mono">
      © 2026 Kevin Paradisi <span aria-hidden="true">·</span> Milano
    </p>
  </div>
</div>

<style>
  /* ---------- HEADER ---------- */
  .v2-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.75rem;
    padding-bottom: 1.5rem;
  }
  .v2-header__id {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* touch-target ≥44px */
    min-height: 2.75rem;
  }
  .v2-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .v2-header__mark-glyph {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-top: 1px;
  }
  .v2-header__id-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .v2-header__name {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
  }
  .v2-header__role {
    font-size: 0.72rem;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }
  .v2-header__arrow {
    display: inline-block;
    margin: 0 0.1em;
  }

  /* Hamburger button */
  .v2-header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    border: 0;
    /* touch-target ≥44px */
    min-height: 2.75rem;
    padding: 0 0.25rem;
    cursor: pointer;
    color: var(--ink);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .v2-header__menu-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .v2-header__menu-label {
    line-height: 1;
  }
  .v2-header__menu-icon {
    position: relative;
    display: inline-block;
    width: 1.5rem;
    height: 1rem;
  }
  .v2-header__menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--ink);
    transition: transform 260ms cubic-bezier(0.2, 0.6, 0.2, 1),
                top 260ms cubic-bezier(0.2, 0.6, 0.2, 1),
                bottom 260ms cubic-bezier(0.2, 0.6, 0.2, 1),
                opacity 200ms;
  }
  .v2-header__menu-icon span:nth-child(1) { top: 4px; }
  .v2-header__menu-icon span:nth-child(2) { bottom: 4px; }

  /* Menu-open state — hamburger diventa X */
  :global(html.menu-open) .v2-header__menu-btn { color: var(--paper); }
  :global(html.menu-open) .v2-header__menu-icon span { background: var(--paper); }
  :global(html.menu-open) .v2-header__menu-icon span:nth-child(1) {
    top: 50%; transform: translateY(-50%) rotate(45deg);
  }
  :global(html.menu-open) .v2-header__menu-icon span:nth-child(2) {
    bottom: 50%; transform: translateY(50%) rotate(-45deg);
  }
  :global(html.menu-open) .v2-header__menu-btn { z-index: 200; }

  /* ---------- MENU OVERLAY ---------- */
  .v2-menu {
    position: fixed;
    inset: 0;
    background: var(--ink);
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms cubic-bezier(0.2, 0.6, 0.2, 1),
                visibility 320ms;
  }
  :global(html.menu-open) .v2-menu {
    opacity: 1;
    visibility: visible;
  }
  :global(html.menu-open) body { overflow: hidden; }

  .v2-menu__shell {
    max-width: 1120px;
    height: 100%;
    margin: 0 auto;
    padding: 6rem clamp(1.25rem, 4vw, 2rem) 3rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 2rem;
  }

  .v2-menu__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    margin: 0;
  }
  .v2-menu__eyebrow-dash {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
  }

  .v2-menu__nav {
    align-self: center;
  }
  .v2-menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }
  .v2-menu__item { display: block; }
  .v2-menu__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 700;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    padding: 0.1em 0;
    transition: color 220ms ease, transform 260ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .v2-menu__link:hover {
    color: var(--paper);
    transform: translateX(-4px);
  }
  .v2-menu__link.is-current {
    color: var(--paper);
  }
  .v2-menu__link-dash {
    display: inline-block;
    width: 0.55em;
    height: 3px;
    background: currentColor;
    opacity: 0;
    transform: translateX(-1rem);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.2, 0.6, 0.2, 1);
    align-self: center;
    margin-right: 0.15em;
  }
  .v2-menu__link.is-current .v2-menu__link-dash,
  .v2-menu__link:hover .v2-menu__link-dash {
    opacity: 1;
    transform: translateX(0);
  }
  .v2-menu__link-ext {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 400;
    font-size: 0.25em;
    letter-spacing: 0.04em;
    margin-left: 0.35em;
    color: color-mix(in srgb, var(--paper) 50%, transparent);
    vertical-align: 0.6em;
  }

  .v2-menu__foot {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--paper) 45%, transparent);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* screen-reader utility */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 640px) {
    .v2-header { padding-top: 1.25rem; padding-bottom: 1rem; }
    .v2-header__mark { width: 2.15rem; height: 2.15rem; }
    .v2-header__name { font-size: 0.85rem; }
    .v2-header__role { font-size: 0.68rem; }
    .v2-header__menu-label { display: none; }
    .v2-menu__list { align-items: flex-start; }
    .v2-menu__shell { padding-top: 5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-menu,
    .v2-menu__link,
    .v2-header__menu-icon span { transition: none; }
  }
</style>

<script>
  const html = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');

  if (btn && overlay) {
    const open = () => {
      html.classList.add('menu-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Chiudi il menu');
      overlay.setAttribute('aria-hidden', 'false');
      // Focus primo link
      const firstLink = overlay.querySelector<HTMLAnchorElement>('.v2-menu__link');
      firstLink?.focus();
    };
    const close = () => {
      html.classList.remove('menu-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Apri il menu');
      overlay.setAttribute('aria-hidden', 'true');
      btn.focus();
    };
    const toggle = () => {
      if (html.classList.contains('menu-open')) close();
      else open();
    };

    btn.addEventListener('click', toggle);

    // Escape chiude
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && html.classList.contains('menu-open')) {
        close();
      }
    });

    // Click su un link chiude il menu (per la navigazione hash)
    overlay.querySelectorAll('.v2-menu__link').forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(close, 60);
      });
    });
  }
</script>
