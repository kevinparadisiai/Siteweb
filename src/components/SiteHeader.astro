---
interface Props { current?: 'work' | 'lab' | 'about' | 'contact' | null; }
const { current = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header
  class="sticky top-0 z-10 border-b border-border bg-bg/90 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
  id="siteHeader"
>
  <div class="container-editorial flex items-center justify-between gap-4 py-4">
    <a href={`${base}/`} class="font-display text-step-1 tracking-tight no-underline">
      <span class="font-normal">[Nome Cognome]</span>
      <em class="not-italic sm:italic font-light text-muted text-step-0"> — Portfolio 2026</em>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Principale">
      {(['work','lab','about','contact'] as const).map((k) => (
        <a
          href={k === 'about' ? `${base}/about` : `${base}/#${k}`}
          aria-current={current === k ? 'page' : undefined}
          class={[
            'text-[0.72rem] uppercase tracking-[0.14em] font-medium no-underline py-2 transition-colors duration-150',
            current === k ? 'text-fg border-b border-fg pb-1' : 'text-muted hover:text-fg',
          ].join(' ')}
        >{k === 'contact' ? 'Contatti' : k.charAt(0).toUpperCase() + k.slice(1)}</a>
      ))}
    </nav>

    <a
      href={`${base}/cv.pdf`}
      class="hidden md:inline-flex items-center gap-2 text-[0.72rem] uppercase tracking-[0.14em] font-medium py-2 px-4 border border-fg min-h-[44px] transition-colors duration-150 hover:bg-fg hover:text-bg no-underline"
      download
    >
      Scarica CV
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v13m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
    </a>

    <button
      class="md:hidden inline-flex items-center justify-center min-w-[44px] min-h-[44px] border border-border-strong"
      type="button"
      aria-label="Apri navigazione"
      aria-expanded="false"
      id="navToggle"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <div id="mobileNav" class="md:hidden hidden border-t border-border bg-bg">
    <div class="container-editorial py-5 flex flex-col gap-4">
      {(['work','lab','about','contact'] as const).map((k) => (
        <a href={k === 'about' ? `${base}/about` : `${base}/#${k}`} class="text-[0.72rem] uppercase tracking-[0.14em] font-medium text-muted no-underline">
          {k === 'contact' ? 'Contatti' : k.charAt(0).toUpperCase() + k.slice(1)}
        </a>
      ))}
      <a href={`${base}/cv.pdf`} download class="inline-flex items-center gap-2 text-[0.72rem] uppercase tracking-[0.14em] py-2 px-4 border border-fg min-h-[44px] no-underline self-start">
        Scarica CV
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const nav = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Chiudi navigazione' : 'Apri navigazione');
  });
</script>
