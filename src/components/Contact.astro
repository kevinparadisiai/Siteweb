---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="relative overflow-hidden bg-accent-deep text-on-accent border-t border-accent">
  <span
    aria-hidden="true"
    class="pointer-events-none select-none absolute -right-1 -bottom-8 font-display italic font-light text-on-accent opacity-[0.05] leading-[0.85] tracking-tight z-0"
    style="font-size: clamp(20rem, 44vw, 42rem); font-variation-settings: 'opsz' 144, 'SOFT' 100;"
  >&</span>

  <section id="contact" class="container-editorial relative z-10 py-24 md:py-32" aria-labelledby="contact-title">
    <p class="eyebrow eyebrow--on-dark mb-5">Contatti</p>
    <h2
      id="contact-title"
      class="font-display font-light italic leading-[1.02] tracking-tight m-0 mb-8 max-w-[20ch] text-on-accent"
      style="font-size: clamp(3.5rem, 8vw + 1rem, 6rem); font-variation-settings: 'opsz' 144, 'SOFT' 100;"
    >
      Se cerchi qualcuno che <span class="not-italic font-normal border-b-2 border-on-accent pb-1">pensi</span> prima di disegnare — scrivimi.
    </h2>

    <ul class="list-none p-0 m-0 flex flex-wrap gap-x-8 gap-y-4 text-step-1">
      <li>
        <a href="mailto:[email@dominio.it]?subject=Portfolio%20—%20&body=Ciao%2C" class="inline-flex items-center gap-2 min-h-[44px] py-2 text-on-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg>
          [email@dominio.it]
        </a>
      </li>
      <li>
        <a href="https://linkedin.com/in/[handle]" rel="noopener" class="inline-flex items-center gap-2 min-h-[44px] py-2 text-on-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3v9zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
          LinkedIn
        </a>
      </li>
      <li>
        <a href={`${base}/cv.pdf`} download class="inline-flex items-center gap-2 min-h-[44px] py-2 text-on-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v13m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
          Scarica CV (PDF)
        </a>
      </li>
    </ul>
  </section>
</div>
