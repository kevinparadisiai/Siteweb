---
// ContactBlock — sezione contatto ripetuta in fondo a home, about
// e case study. Bg dark (--ink), display gigante Bricolage 800 opsz
// 96, eyebrow mono paper, due colonne meta a sinistra + azioni a
// destra. Replica screen 4 del ref (Damian Watracz).
import V2Eyebrow from '@/components/V2Eyebrow.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="contact-block" aria-labelledby="contact-title">
  <div class="contact-block__shell">

    <V2Eyebrow variant="paper">Contact</V2Eyebrow>

    <h2 id="contact-title" class="contact-block__title">
      Scrivimi —
      <span class="contact-block__title-2">lavoriamo insieme.</span>
    </h2>

    <div class="contact-block__grid">
      <div class="contact-block__col">
        <V2Eyebrow variant="paper" as="span">Recapiti</V2Eyebrow>
        <ul class="contact-block__list">
          <li>
            <a href="mailto:kevinparadisiai@gmail.com" class="contact-block__link">
              kevinparadisiai@gmail.com
              <span class="contact-block__link-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li class="contact-block__meta">Milano, Italia · EU</li>
          <li class="contact-block__meta">Disponibile da settembre 2026</li>
        </ul>
      </div>

      <div class="contact-block__col">
        <V2Eyebrow variant="paper" as="span">Altrove</V2Eyebrow>
        <ul class="contact-block__list">
          <li>
            <a
              href="https://www.linkedin.com/in/kevinparadisi"
              target="_blank"
              rel="noopener"
              class="contact-block__link"
            >
              LinkedIn
              <span class="contact-block__link-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a
              href={`${base}/cv.pdf`}
              download="Kevin-Paradisi-CV.pdf"
              class="contact-block__link"
            >
              Scarica CV (PDF)
              <span class="contact-block__link-arrow" aria-hidden="true">↓</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

  </div>
</section>

<style>
  .contact-block {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(4rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
    margin-top: 5rem;
  }
  .contact-block__shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-block__title {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: var(--paper);
    margin: 0;
    max-width: 16ch;
  }
  .contact-block__title-2 {
    display: block;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .contact-block__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
  }
  .contact-block__col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contact-block__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .contact-block__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* touch-target ≥44px */
    min-height: 2.75rem;
    padding: 0 0.15rem;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--paper);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    transition: border-color 200ms ease, color 200ms ease;
  }
  .contact-block__link:hover {
    border-color: var(--paper);
  }
  .contact-block__link-arrow {
    display: inline-block;
    transition: transform 240ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .contact-block__link:hover .contact-block__link-arrow {
    transform: translate(3px, -1px);
  }
  .contact-block__meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .contact-block__grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-block__link-arrow { transition: none; }
  }
</style>
