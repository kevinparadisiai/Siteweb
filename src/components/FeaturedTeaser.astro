---
import { projects } from '@/data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = projects[0]; // most recent project
const dark = !!featured.onSignatureDark;
---
<section class="bg-bg pb-20 md:pb-28" id="featured" aria-labelledby="featured-anchor">
  <div class="container-editorial">

    <header class="pt-8 md:pt-12 pb-8 md:pb-10 mb-10 md:mb-14 border-b border-border">
      <p class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 mb-6 md:mb-8" data-reveal>
        <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
        <span class="tabular-nums">III</span>
        <span aria-hidden="true" class="opacity-40">—</span>
        <span>Ultimo lavoro</span>
      </p>
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <h2
          id="featured-anchor"
          class="font-body font-black leading-[0.98] m-0 text-fg max-w-[18ch]"
          style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.035em;"
          data-reveal
        >
          Un caso su cui vale la pena aprirsi.
        </h2>
        <a
          href={`${base}/work/`}
          class="btn-fill relative overflow-hidden inline-flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.16em] font-medium py-3 px-5 border border-fg no-underline self-start md:self-end"
          data-cursor-label="Vedi tutti i progetti"
        >
          <span class="relative z-10">Tutti i progetti</span>
          <svg class="relative z-10" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </header>

    <a
      href={`${base}/work/${featured.slug}/`}
      class="group relative block overflow-hidden no-underline min-h-[320px] md:min-h-[380px] p-8 md:p-12 transition-transform duration-300 ease-editorial hover:-translate-y-1"
      style={`background-color: ${featured.signatureColor}; color: ${dark ? '#0A0A0A' : '#FFFFFF'};`}
      data-cursor-label="Leggi il case study"
      data-reveal
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-2 -bottom-10 font-display italic font-light leading-[0.8] tracking-tighter z-0"
        style={`font-size: clamp(14rem, 26vw, 24rem); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-variant-numeric: tabular-nums; opacity: ${dark ? '0.12' : '0.14'};`}
      >{featured.num}</span>

      <div class="relative z-10 grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-10 h-full">
        <div class="flex flex-col">
          <p class:list={['text-[0.72rem] uppercase tracking-[0.14em] font-medium m-0 mb-5', dark ? 'opacity-70' : 'opacity-80']}>{featured.eyebrow}</p>
          <h3
            class="font-body font-black leading-[1.02] tracking-tight m-0 mb-5 max-w-[20ch]"
            style="font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -0.03em;"
          >{featured.title}</h3>
          <p class:list={['text-step-0 md:text-step-1 leading-[1.5] max-w-[52ch] m-0', dark ? 'opacity-80' : 'opacity-85']}>{featured.lede}</p>
        </div>

        <div class="flex flex-col justify-between items-start md:items-end gap-8">
          <div class="text-left md:text-right">
            <p
              class="font-body font-black leading-none tracking-tight m-0 tabular-nums"
              style="font-size: clamp(3.5rem, 6vw, 5.5rem); letter-spacing: -0.04em;"
            >{featured.metric.value}</p>
            <p class:list={['font-mono text-[0.72rem] tracking-[0.06em] max-w-[20ch] mt-3 m-0 md:ml-auto', dark ? 'opacity-70' : 'opacity-80']}>{featured.metric.label}</p>
          </div>
          <div class:list={['inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-[0.14em] font-medium', dark ? 'opacity-90' : 'opacity-95']}>
            <span>{featured.client} · {featured.year}</span>
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center w-11 h-11 rounded-full border transition-transform duration-300 ease-editorial group-hover:translate-x-1"
              style={`border-color: ${dark ? 'rgba(10,10,10,0.4)' : 'rgba(255,255,255,0.5)'};`}
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </span>
          </div>
        </div>
      </div>
    </a>

  </div>
</section>
