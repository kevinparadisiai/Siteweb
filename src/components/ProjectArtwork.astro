---
interface Props {
  signatureColor: string;
  onSignatureDark?: boolean;
  client: string;
  num: string;
  variant?: string; // kept for API compatibility; ignored in this minimal version
  alt: string;
  aspect?: string;
}
const {
  signatureColor,
  onSignatureDark = false,
  client,
  num,
  alt,
  aspect = 'aspect-[4/3]',
} = Astro.props;

const onSig = onSignatureDark ? '#0A0A0A' : '#FFFFFF';
---
<figure
  class:list={['project-artwork relative overflow-hidden', aspect]}
  aria-label={alt}
  role="figure"
  style={`background-color: ${signatureColor};`}
>
  <!-- Tiny number top-left -->
  <span
    class="absolute top-5 left-5 font-mono text-[0.68rem] tracking-[0.16em] uppercase opacity-70"
    style={`color: ${onSig};`}
  >{num.padStart(2, '0')}</span>

  <!-- Small "placeholder" tag top-right -->
  <span
    class="absolute top-5 right-5 font-mono text-[0.62rem] tracking-[0.14em] uppercase opacity-55"
    style={`color: ${onSig};`}
  >Placeholder</span>

  <!-- Big client wordmark centered / bottom-left -->
  <span
    class="absolute bottom-5 left-5 right-5 font-body font-black leading-[0.9] tracking-tight m-0"
    style={`color: ${onSig}; font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -0.035em;`}
  >{client}</span>
</figure>

<style>
  .project-artwork {
    line-height: 0;
    box-shadow: 0 20px 40px -24px rgba(10, 10, 10, 0.20);
  }
</style>
