---
interface Props {
  num: string;
  eyebrow: string;
  title: string;
  description: string;
  meta: string;
  href: string;
  color: 1 | 2 | 3;
  disabled?: boolean;
}
const { num, eyebrow, title, description, meta, href, color, disabled = false } = Astro.props;
const isFeatured = color === 1;
const Tag = disabled ? 'div' : 'a';

// Featured: near-black card with cream text (Sketchin dark case study feel)
// Placeholder: light-grey card with dark text, subordinate
const cardBg = isFeatured ? 'bg-card-1' : 'bg-card-2';
const textOnCard = isFeatured ? 'text-on-card-dark' : 'text-on-card';
const borderMuted = isFeatured ? 'border-white/15' : 'border-black/12';
const borderStrong = isFeatured ? 'border-white/40' : 'border-black/40';
const hoverBorder = isFeatured ? 'group-hover:border-white' : 'group-hover:border-black';
---
<Tag
  href={disabled ? undefined : href}
  data-num={num}
  data-cursor-label={disabled ? undefined : 'Leggi il case study'}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[
    'group relative overflow-hidden flex flex-col p-6 min-h-[360px] w-full rounded no-underline',
    cardBg, textOnCard,
    disabled
      ? 'cursor-default opacity-90'
      : 'transition-transform duration-300 ease-editorial hover:-translate-y-1',
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute -right-1 -bottom-8 font-display italic font-light leading-[0.8] tracking-tighter opacity-[0.08] z-0 transition-opacity duration-300 ease-editorial group-hover:opacity-[0.14]',
      isFeatured ? 'text-white' : 'text-black',
    ]}
    style="font-size: clamp(12rem, 22vw, 20rem); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-variant-numeric: tabular-nums;"
  >{num}</span>

  <span class:list={[
    'relative z-10 text-[0.72rem] uppercase tracking-[0.14em] font-medium opacity-75',
    "before:content-['—_']", 'before:opacity-100', 'before:text-accent',
  ]}>{eyebrow}</span>

  <div class="relative z-10 mt-6 flex-1">
    <h3 class="font-display font-normal text-step-2 leading-[1.15] tracking-tight m-0 mb-3 max-w-[22ch]">{title}</h3>
    <p class="text-step-0 leading-[1.5] opacity-75 max-w-[40ch] m-0">{description}</p>
  </div>

  <div class:list={[
    'relative z-10 mt-6 pt-4 border-t flex justify-between items-center gap-3 text-[0.7rem] uppercase tracking-[0.1em] font-medium',
    borderMuted,
  ]}>
    <span class="opacity-75">{disabled ? 'In arrivo' : meta}</span>
    {disabled ? (
      <span
        aria-hidden="true"
        class:list={['inline-flex items-center justify-center w-11 h-11 border rounded-full opacity-50', borderStrong]}
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><circle cx="8" cy="8" r="1"/><circle cx="4" cy="8" r="1"/><circle cx="12" cy="8" r="1"/></svg>
      </span>
    ) : (
      <span class:list={[
        'inline-flex items-center justify-center w-11 h-11 border rounded-full transition-[border-color,transform] duration-300 ease-editorial group-hover:translate-x-1',
        borderStrong, hoverBorder,
      ]}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
      </span>
    )}
  </div>
</Tag>
