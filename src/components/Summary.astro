---
import SectionAnchor from './SectionAnchor.astro';
import ChapterMarker from './ChapterMarker.astro';
const cols = [
  { num: '01', title: 'Cosa faccio meglio', items: ['Discovery e framing', 'Design system', 'Interaction design', 'Ricerca qualitativa', 'Facilitazione workshop'] },
  { num: '02', title: 'Settori',           items: ['Fintech', 'SaaS B2B', 'Healthcare', 'Pubblico / Servizi', 'Retail'] },
  { num: '03', title: 'Come lavoro',       items: ['Da problema, non da mockup', 'Prototipare per decidere', 'Metriche prima del delivery', 'Sistemi, non schermate'] },
];
---
<section id="sintesi" class="bg-surface pb-20 md:pb-28" aria-labelledby="summary-anchor">
  <ChapterMarker chapter="II" label="Sintesi" />
  <div class="container-editorial">

    <SectionAnchor
      chapter="II"
      label="Sintesi"
      verb="Penso."
      subtitle="Cosa so fare, per chi, e come."
    />

    <div class="border border-border-strong/40 rounded" data-reveal>
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-border-strong/40">
        {cols.map((col, i) => (
          <div class="p-6 md:p-8" data-reveal style={`--reveal-delay: ${i + 1};`}>
            <div class="flex items-baseline gap-3 mb-5">
              <span class="font-display italic font-light text-step-2 leading-none tabular-nums text-accent" style="font-variation-settings: 'opsz' 72, 'SOFT' 100;">{col.num}</span>
              <h3 class="eyebrow m-0">{col.title}</h3>
            </div>
            <ul class="list-none p-0 m-0 font-display text-step-2 leading-tight font-normal">
              {col.items.map((it, j, arr) => (
                <li class={`py-3 ${j < arr.length - 1 ? 'border-b border-border' : ''}`}>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
