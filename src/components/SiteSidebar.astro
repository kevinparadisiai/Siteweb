---
interface Props { current?: string; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { id: 'work',    label: 'Work',     href: `${base}/work/`    },
  { id: 'lab',     label: 'Lab',      href: `${base}/lab/`     },
  { id: 'contact', label: 'Contatti', href: `${base}/contact/` },
];
const sublinks = [
  { label: 'TIM · self-caring',    href: `${base}/work/tim/`   },
  { label: 'CAP · area riservata', href: `${base}/work/cap/`   },
  { label: 'Eni · Archivio',       href: `${base}/work/eni/`   },
];
---
<!-- Persistent top-left brand + fixed center-left hamburger (Sketchin pattern) -->
<div class="site-brandbar" data-hero-in-view="true">
  <a href={`${base}/`} class="site-brandbar__brand" aria-label="Home — Kevin Paradisi">
    <span aria-hidden="true">Kevin<em>.</em></span>
    <span class="sr-only">Kevin Paradisi</span>
  </a>
  <button
    type="button"
    class="site-brandbar__trigger"
    id="menuTrigger"
    aria-expanded="false"
    aria-controls="siteMenu"
    aria-label="Apri menu"
    data-cursor-label="Menu"
  >
    <svg width="30" height="18" viewBox="0 0 30 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M0 4h30M0 14h30"/>
    </svg>
  </button>
</div>

<!-- X close: sibling of the overlay so no ancestor clip-path can hide it -->
<button
  type="button"
  class="site-menu-close"
  id="menuClose"
  aria-label="Chiudi menu"
  data-cursor-label="Chiudi"
>
  <svg width="44" height="44" viewBox="0 0 32 32" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <path d="M7 7l18 18M25 7L7 25"/>
  </svg>
  <span class="sr-only">Chiudi menu</span>
</button>

<!-- Exploded nav — visible only inside the hero (Sketchin homepage pattern) -->
<nav class="hero-nav" id="heroNav" aria-label="Sezioni">
  {items.map((it, i) => (
    <a
      href={it.href}
      class="hero-nav__link"
      data-chapter-link={it.id}
      aria-current={current === it.id ? 'true' : undefined}
      style={`--hn-delay: ${i * 60}ms;`}
    >{it.label}</a>
  ))}
  <div class="hero-nav__sub" aria-label="Scorciatoie">
    {sublinks.map((s) => (
      <a href={s.href} class="hero-nav__sublink">{s.label}</a>
    ))}
  </div>
</nav>

<!-- Full-screen overlay menu — Sketchin big red panel -->
<div
  id="siteMenu"
  class="site-menu"
  role="dialog"
  aria-modal="true"
  aria-labelledby="siteMenuTitle"
  aria-hidden="true"
  tabindex="-1"
>
  <h2 id="siteMenuTitle" class="sr-only">Navigazione</h2>

  <div class="site-menu__grid">
    <nav class="site-menu__nav" aria-label="Menu principale">
      {items.map((it, i) => (
        <a
          href={it.href}
          class="site-menu__link"
          data-menu-link
          aria-current={current === it.id ? 'true' : undefined}
          style={`--menu-delay: ${i * 65}ms;`}
        >{it.label}</a>
      ))}

      <ul class="site-menu__sub" aria-label="Scorciatoie">
        {sublinks.map((s) => (
          <li><a href={s.href} class="site-menu__sublink" data-menu-link>{s.label}</a></li>
        ))}
      </ul>
    </nav>

    <aside class="site-menu__contact" aria-labelledby="menuContactTitle">
      <p class="site-menu__eyebrow">Parliamone</p>
      <h3
        id="menuContactTitle"
        class="site-menu__contact-title"
      >Raccontami il prossimo progetto.</h3>

      <form
        class="site-menu__form"
        id="menuContactForm"
        action="mailto:kevinparadisiai@gmail.com"
        method="post"
        enctype="text/plain"
        novalidate
      >
        <label class="site-menu__field">
          <span class="site-menu__field-label">Nome</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="site-menu__field">
          <span class="site-menu__field-label">E-mail *</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="site-menu__field">
          <span class="site-menu__field-label">Di che si tratta?</span>
          <input type="text" name="subject" />
        </label>

        <p class="site-menu__consent">
          Nessuna newsletter, nessun tracker.
          Rispondo entro <strong>48h</strong> in giorni feriali.
        </p>

        <button type="submit" class="site-menu__submit" data-cursor-label="Scrivimi">
          <span>Scrivimi</span>
          <svg width="18" height="14" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 9h22M15 2l7 7-7 7"/>
          </svg>
        </button>
      </form>

      <ul class="site-menu__socials" aria-label="Social">
        <li><a href="https://www.linkedin.com/" target="_blank" rel="noopener" data-menu-link>LinkedIn <span class="sr-only">(si apre in una nuova scheda)</span></a></li>
        <li><a href="https://www.behance.net/" target="_blank" rel="noopener" data-menu-link>Behance <span class="sr-only">(si apre in una nuova scheda)</span></a></li>
        <li><a href="https://read.cv/" target="_blank" rel="noopener" data-menu-link>Read.cv <span class="sr-only">(si apre in una nuova scheda)</span></a></li>
        <li><a href="mailto:kevinparadisiai@gmail.com" data-menu-link>Email diretto</a></li>
      </ul>

      <p id="menuContactStatus" class="site-menu__status" role="status" aria-live="polite"></p>
    </aside>
  </div>

  <p class="site-menu__meta" aria-hidden="true">
    <span>Portfolio · 2026</span>
    <span>Disponibile da settembre · Remoto o Milano</span>
  </p>
</div>

<script>
  // ================= Menu overlay =================
  const trigger = document.getElementById('menuTrigger') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('menuClose') as HTMLButtonElement | null;
  const menu = document.getElementById('siteMenu') as HTMLElement | null;
  const brandbar = document.querySelector<HTMLElement>('.site-brandbar');
  const heroNav = document.getElementById('heroNav');
  const form = document.getElementById('menuContactForm') as HTMLFormElement | null;

  // Remember what had focus before opening, so we can restore it on close.
  let previousFocus: HTMLElement | null = null;

  // Return every keyboard-focusable descendant in DOM order.
  const focusableInMenu = (): HTMLElement[] => {
    if (!menu) return [];
    const sel = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
    return Array.from(menu.querySelectorAll<HTMLElement>(sel))
      .filter((el) => !el.hasAttribute('inert') && el.offsetParent !== null);
  };

  const trapKeydown = (e: KeyboardEvent) => {
    if (e.key !== 'Tab' || !menu?.classList.contains('is-open')) return;
    // Include the external close button in the trap cycle.
    const nodes = [...focusableInMenu(), ...(closeBtn ? [closeBtn] : [])];
    if (nodes.length === 0) return;
    const first = nodes[0];
    const last = nodes[nodes.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && active === first) { last.focus(); e.preventDefault(); }
    else if (!e.shiftKey && active === last) { first.focus(); e.preventDefault(); }
  };

  const setOpen = (open: boolean) => {
    if (!menu || !trigger) return;
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
    document.documentElement.classList.toggle('menu-open', open);
    if (open) {
      previousFocus = (document.activeElement as HTMLElement) ?? trigger;
      // Delay one frame so the CSS clip-path reveal begins and focusable
      // elements have their real layout box before we focus into them.
      requestAnimationFrame(() => {
        (menu.querySelector<HTMLAnchorElement>('.site-menu__link') ?? closeBtn)?.focus();
      });
      document.addEventListener('keydown', trapKeydown);
    } else {
      document.removeEventListener('keydown', trapKeydown);
      (previousFocus ?? trigger).focus();
    }
  };

  trigger?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) setOpen(false);
  });
  menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // Menu form → build mailto: with prefilled subject/body. Announces status
  // via #menuContactStatus (aria-live=polite) so screen readers hear errors
  // and success without a visual toast.
  const statusEl = document.getElementById('menuContactStatus');
  const announce = (text: string) => { if (statusEl) statusEl.textContent = text; };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const subject = String(fd.get('subject') || '').trim();
    const emailInput = form.querySelector('input[name=email]') as HTMLInputElement | null;
    const emailValid = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!emailValid) {
      emailInput?.setAttribute('aria-invalid', 'true');
      announce('Inserisci una email valida per continuare.');
      emailInput?.focus();
      return;
    }
    emailInput?.removeAttribute('aria-invalid');
    const subj = subject ? `Portfolio — ${subject}` : 'Portfolio — parliamone';
    const body = [
      `Ciao Kevin,`,
      ``,
      name ? `Sono ${name}.` : '',
      `[racconta cosa hai in mente]`,
      ``,
      `— ${name || ''} ${email ? `<${email}>` : ''}`.trim(),
    ].filter(Boolean).join('\n');
    announce('Apro il tuo client email…');
    window.location.href = `mailto:kevinparadisiai@gmail.com?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
  });

  // ================= Hero-in-view: swap between exploded nav and hamburger =================
  // Uses scrollY (not IntersectionObserver) because the sticky-stack keeps the
  // hero element intersecting the viewport even when a later section covers it.
  const hero = document.getElementById('hero');
  if (hero) {
    let ticking = false;
    const check = () => {
      const threshold = Math.max(120, window.innerHeight * 0.45);
      const inHero = window.scrollY < threshold;
      if (brandbar) brandbar.dataset.heroInView = String(inHero);
      if (heroNav) heroNav.classList.toggle('is-visible', inHero);
      ticking = false;
    };
    check();
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(check); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', check);
  } else if (heroNav) {
    heroNav.classList.remove('is-visible');
    if (brandbar) brandbar.dataset.heroInView = 'false';
  }
</script>
