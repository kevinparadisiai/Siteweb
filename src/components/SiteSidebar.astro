---
interface Props { current?: string; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { id: 'work',    label: 'Work',     href: `${base}/work/`    },
  { id: 'lab',     label: 'Lab',      href: `${base}/lab/`     },
  { id: 'contact', label: 'Contatti', href: `${base}/contact/` },
];
const sublinks = [
  { label: 'Case study 01',        href: `${base}/case-study/` },
  { label: 'AI come specchio',     href: `${base}/lab-ai/`     },
  { label: 'Scarica CV',           href: `${base}/cv.pdf`      },
];
---
<!-- Persistent top-left: brand (always) + hamburger (only after hero) -->
<div class="site-brandbar" data-hero-in-view="true">
  <a href={`${base}/`} class="site-brandbar__brand" aria-label="Home — Kevin Paradisi">
    <span aria-hidden="true">Kevin<em>.</em></span>
    <span class="sr-only">Kevin Paradisi</span>
  </a>
  <button
    type="button"
    class="site-brandbar__trigger"
    id="menuTrigger"
    aria-expanded="false"
    aria-controls="siteMenu"
    aria-label="Apri menu"
    data-cursor-label="Menu"
  >
    <svg width="26" height="14" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M0 3h26M0 11h26"/>
    </svg>
  </button>
</div>

<!-- Exploded nav — visible only inside the hero (Sketchin homepage pattern) -->
<nav class="hero-nav" id="heroNav" aria-label="Sezioni">
  {items.map((it, i) => (
    <a
      href={it.href}
      class="hero-nav__link"
      data-chapter-link={it.id}
      aria-current={current === it.id ? 'true' : undefined}
      style={`--hn-delay: ${i * 60}ms;`}
    >{it.label}</a>
  ))}
  <div class="hero-nav__sub" aria-label="Scorciatoie">
    {sublinks.map((s) => (
      <a href={s.href} class="hero-nav__sublink">{s.label}</a>
    ))}
  </div>
</nav>

<!-- Full-screen overlay menu — Sketchin big red panel -->
<div
  id="siteMenu"
  class="site-menu"
  role="dialog"
  aria-modal="true"
  aria-labelledby="siteMenuTitle"
  aria-hidden="true"
  tabindex="-1"
>
  <h2 id="siteMenuTitle" class="sr-only">Navigazione</h2>

  <button
    type="button"
    class="site-menu__close"
    id="menuClose"
    aria-label="Chiudi menu"
    data-cursor-label="Chiudi"
  >
    <svg width="26" height="14" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M6 6l20 20M26 6L6 26"/>
    </svg>
    <span class="sr-only">Chiudi</span>
  </button>

  <div class="site-menu__grid">
    <nav class="site-menu__nav" aria-label="Menu principale">
      {items.map((it, i) => (
        <a
          href={it.href}
          class="site-menu__link"
          data-menu-link
          aria-current={current === it.id ? 'true' : undefined}
          style={`--menu-delay: ${i * 65}ms;`}
        >{it.label}</a>
      ))}
    </nav>

    <aside class="site-menu__side" aria-label="Contatti">
      <div class="site-menu__block">
        <p class="site-menu__eyebrow">Scrivimi</p>
        <a
          href="mailto:kevinparadisiai@gmail.com"
          class="site-menu__mail"
          data-menu-link
          data-cursor-label="Scrivi email"
        >kevinparadisiai@gmail.com</a>
      </div>

      <div class="site-menu__block">
        <p class="site-menu__eyebrow">Portfolio</p>
        <a
          href={`${base}/cv.pdf`}
          download
          class="site-menu__cta"
          data-menu-link
          data-cursor-label="Download PDF"
        >
          <span>Scarica CV</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
        </a>
      </div>

      <ul class="site-menu__socials" aria-label="Social">
        <li><a href="https://www.linkedin.com/" target="_blank" rel="noopener" data-menu-link>LinkedIn</a></li>
        <li><a href="https://www.behance.net/" target="_blank" rel="noopener" data-menu-link>Behance</a></li>
        <li><a href="https://read.cv/" target="_blank" rel="noopener" data-menu-link>Read.cv</a></li>
      </ul>
    </aside>
  </div>

  <p class="site-menu__meta" aria-hidden="true">
    <span>Portfolio · 2026</span>
    <span>Disponibile da settembre</span>
  </p>
</div>

<script>
  // ================= Menu overlay =================
  const trigger = document.getElementById('menuTrigger') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('menuClose') as HTMLButtonElement | null;
  const menu = document.getElementById('siteMenu') as HTMLElement | null;
  const brandbar = document.querySelector<HTMLElement>('.site-brandbar');
  const heroNav = document.getElementById('heroNav');

  const setOpen = (open: boolean) => {
    if (!menu || !trigger) return;
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
    document.documentElement.classList.toggle('menu-open', open);
    if (open) menu.querySelector<HTMLAnchorElement>('.site-menu__link')?.focus();
    else trigger.focus();
  };

  trigger?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) setOpen(false);
  });
  menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // ================= Hero-in-view: swap between exploded nav and hamburger =================
  // Uses scrollY (not IntersectionObserver) because the sticky-stack keeps the
  // hero element intersecting the viewport even when a later section covers it.
  const hero = document.getElementById('hero');
  if (hero) {
    let ticking = false;
    const check = () => {
      const threshold = Math.max(120, window.innerHeight * 0.45);
      const inHero = window.scrollY < threshold;
      if (brandbar) brandbar.dataset.heroInView = String(inHero);
      if (heroNav) heroNav.classList.toggle('is-visible', inHero);
      ticking = false;
    };
    check();
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(check); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', check);
  } else if (heroNav) {
    // Non-home page: hero doesn't exist → keep exploded nav hidden, hamburger visible.
    heroNav.classList.remove('is-visible');
    if (brandbar) brandbar.dataset.heroInView = 'false';
  }
</script>
