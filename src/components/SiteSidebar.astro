---
interface Props { current?: string; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const chapters = [
  { id: 'hero',    num: 'I',   verb: 'designer.', href: `${base}/#hero`    },
  { id: 'sintesi', num: 'II',  verb: 'Penso.',    href: `${base}/#sintesi` },
  { id: 'work',    num: 'III', verb: 'Progetto.', href: `${base}/#work`    },
  { id: 'lab',     num: 'IV',  verb: 'Provo.',    href: `${base}/#lab`     },
  { id: 'contact', num: 'V',   verb: 'Scrivimi.', href: `${base}/#contact` },
];
---
<aside class="site-sidebar hidden lg:flex" aria-label="Navigazione capitoli">
  <div class="site-sidebar__inner">

    <div>
      <a href={`${base}/`} class="site-sidebar__brand" aria-label="Home — Kevin Paradisi">
        <span aria-hidden="true">Kevin<em class="italic font-light">.</em></span>
        <span class="sr-only">Kevin Paradisi</span>
      </a>
    </div>

    <nav class="site-sidebar__nav" aria-label="Capitoli">
      {chapters.map((ch) => (
        <a
          href={ch.href}
          class="site-sidebar__link"
          data-chapter-link={ch.id}
          aria-current={current === ch.id ? 'true' : undefined}
        >
          <span class="site-sidebar__num tabular-nums" aria-hidden="true">{ch.num}</span>
          <span class="site-sidebar__verb">{ch.verb}</span>
        </a>
      ))}
    </nav>

    <a
      href={`${base}/cv.pdf`}
      download
      class="site-sidebar__cta"
      data-cursor-label="Download PDF"
    >
      <span>Scarica CV</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
    </a>

  </div>
</aside>

<script>
  // Sync current chapter with sidebar highlight based on scroll position.
  const sections = ['hero', 'sintesi', 'work', 'lab', 'contact'];
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]').forEach((a) => {
    const id = a.dataset.chapterLink;
    if (id) links.set(id, a);
  });

  if ('IntersectionObserver' in window && links.size > 0) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const id = (entry.target as HTMLElement).id;
        if (!id) return;
        if (entry.isIntersecting) {
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(id)?.setAttribute('aria-current', 'true');
        }
      });
    }, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });

    sections.forEach((s) => {
      const el = document.getElementById(s);
      if (el) io.observe(el);
    });
  }
</script>
