---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section
  class="relative overflow-hidden bg-accent-deep text-on-accent"
  id="contact-cta"
  aria-labelledby="cta-anchor"
>
  <span
    aria-hidden="true"
    class="pointer-events-none select-none absolute -right-2 -bottom-8 font-display italic font-light text-on-accent opacity-[0.05] leading-[0.85] z-0"
    style="font-size: clamp(18rem, 42vw, 40rem); font-variation-settings: 'opsz' 144, 'SOFT' 100;"
  >&amp;</span>

  <div class="container-editorial relative z-10 py-24 md:py-32">

    <p class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.18em] font-medium text-on-accent/70 m-0 mb-8" data-reveal>
      <span class="inline-block w-10 h-px bg-on-accent/60" aria-hidden="true"></span>
      <span class="tabular-nums">V</span>
      <span aria-hidden="true" class="opacity-40">—</span>
      <span>Scrivimi</span>
    </p>

    <h2
      id="cta-anchor"
      class="font-body font-black leading-[0.95] m-0 text-on-accent max-w-[22ch]"
      style="font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -0.035em;"
      data-reveal
    >
      Cerchi qualcuno che <span class="opacity-75">pensi prima</span> di disegnare.
    </h2>

    <div class="mt-10 md:mt-14 flex flex-col md:flex-row md:items-center gap-6 md:gap-10" data-reveal>
      <a
        href={`${base}/contact/`}
        class="btn-fill relative overflow-hidden inline-flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.16em] font-medium py-3 px-5 border border-on-accent no-underline text-on-accent self-start"
        style="color: theme('colors.on-accent');"
        data-cursor-label="Parliamone"
      >
        <span class="relative z-10">Parliamone</span>
        <svg class="relative z-10" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>

      <a
        href="mailto:kevinparadisiai@gmail.com"
        class="font-display italic font-light text-on-accent text-step-1 underline underline-offset-4 decoration-1 hover:decoration-2"
        data-cursor-label="Scrivi email"
      >kevinparadisiai@gmail.com</a>
    </div>

  </div>
</section>
