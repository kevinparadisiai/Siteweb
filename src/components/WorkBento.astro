---
import { projects } from '@/data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tim = projects.find((p) => p.slug === 'tim')!;
const cap = projects.find((p) => p.slug === 'cap')!;
const eni = projects.find((p) => p.slug === 'eni')!;

// Single lab experiment for now; when we add more they get added here.
const lab = {
  href: `${base}/lab-ai/`,
  eyebrow: 'Lab · AI · Metodo',
  title: 'Cosa succede se chiedo a un LLM di argomentare contro le mie decisioni?',
  lede: 'Un mese di prompt "avvocato del diavolo" su tre progetti reali. Su 2 su 3 le prime obiezioni erano lacune che avevo davvero sotto-esplorato.',
  metric: { value: '3', label: 'Progetti reali, 1 mese di iterazioni' },
  meta: 'Giugno 2024 · 5 min',
  signatureColor: '#0A0A0A',
  onSignatureDark: false,
  kind: 'lab' as const,
};

const tiles = [
  { data: tim, span: 'md:col-span-8', aspect: 'md:aspect-[16/11]' },
  { data: eni, span: 'md:col-span-4', aspect: 'md:aspect-[4/5]' },
  { data: lab, span: 'md:col-span-5', aspect: 'md:aspect-[4/5]' },
  { data: cap, span: 'md:col-span-7', aspect: 'md:aspect-[16/10]' },
];

const tag = (t: typeof lab | typeof tim) =>
  'kind' in t && t.kind === 'lab' ? 'Sperimentazione' : 'Consulenza';
---
<section class="bg-bg py-20 md:py-28" id="work" aria-labelledby="bento-anchor">
  <div class="container-editorial">

    <header class="mb-12 md:mb-16 max-w-[70ch]">
      <p class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 mb-6" data-reveal>
        <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
        <span class="tabular-nums">II</span>
        <span aria-hidden="true" class="opacity-40">—</span>
        <span>Progetti &amp; Lab</span>
      </p>
      <h2
        id="bento-anchor"
        class="font-body font-black leading-[0.98] m-0 text-fg"
        style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.035em;"
        data-reveal
      >
        Progetti che spostano <span class="font-display italic font-light text-accent">decisioni</span>, ipotesi che <span class="font-display italic font-light text-accent">provo</span>.
      </h2>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6">
      {tiles.map(({ data, span, aspect }, i) => {
        const dark = !!data.onSignatureDark;
        const isLab = 'kind' in data && data.kind === 'lab';
        return (
          <a
            href={data.href}
            class:list={[
              'group relative overflow-hidden no-underline flex flex-col justify-between p-6 md:p-8',
              'min-h-[320px]', span, aspect,
              'transition-transform duration-500 ease-editorial hover:-translate-y-1',
            ]}
            style={`background-color: ${data.signatureColor}; color: ${dark ? '#0A0A0A' : '#FFFFFF'}; --reveal-delay: ${i};`}
            data-cursor-label={isLab ? 'Leggi la nota' : 'Leggi il case study'}
            data-reveal
          >
            <!-- Corner glyph: project num or lab flask -->
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -right-3 -bottom-12 font-display italic font-light leading-[0.8] tracking-tighter z-0 transition-opacity duration-500 group-hover:opacity-90"
              style={`font-size: clamp(10rem, 20vw, 18rem); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-variant-numeric: tabular-nums; opacity: ${dark ? '0.12' : '0.16'};`}
            >{isLab ? '§' : (data as typeof tim).num}</span>

            <!-- Top: type tag + eyebrow -->
            <div class="relative z-10 flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'font-mono text-[0.62rem] tracking-[0.18em] uppercase px-2 py-1',
                    isLab ? 'bg-white/15' : 'bg-white/12',
                  ]}
                  style={dark ? 'background: rgba(10,10,10,0.10);' : ''}
                >{tag(data)}</span>
                <span class:list={['font-mono text-[0.62rem] tracking-[0.14em] uppercase', dark ? 'opacity-60' : 'opacity-70']}>{data.eyebrow}</span>
              </div>
              <h3
                class="font-body font-black leading-[1.05] tracking-tight m-0 max-w-[22ch]"
                style="font-size: clamp(1.5rem, 2.4vw, 2.4rem); letter-spacing: -0.03em;"
              >{data.title}</h3>
              {'lede' in data && data.lede && (
                <p class:list={['text-step-0 leading-[1.5] max-w-[46ch] m-0', dark ? 'opacity-80' : 'opacity-85']}>{data.lede}</p>
              )}
            </div>

            <!-- Bottom: metric + meta -->
            <div class="relative z-10 mt-8 pt-6 border-t flex items-end justify-between gap-4"
                 style={`border-color: ${dark ? 'rgba(10,10,10,0.20)' : 'rgba(255,255,255,0.28)'};`}>
              <div>
                <p
                  class="font-body font-black leading-none tracking-tight m-0 tabular-nums"
                  style="font-size: clamp(2.5rem, 4.5vw, 3.8rem); letter-spacing: -0.035em;"
                >{data.metric.value}</p>
                <p class:list={['font-mono text-[0.66rem] tracking-[0.06em] max-w-[24ch] mt-2 m-0', dark ? 'opacity-70' : 'opacity-80']}>{data.metric.label}</p>
              </div>
              <div class:list={['inline-flex items-center gap-3 text-[0.7rem] uppercase tracking-[0.14em] font-medium shrink-0', dark ? 'opacity-90' : 'opacity-95']}>
                <span>{isLab ? (data as typeof lab).meta : `${(data as typeof tim).client} · ${(data as typeof tim).year}`}</span>
                <span
                  aria-hidden="true"
                  class="inline-flex items-center justify-center w-11 h-11 rounded-full border transition-transform duration-300 ease-editorial group-hover:translate-x-1"
                  style={`border-color: ${dark ? 'rgba(10,10,10,0.4)' : 'rgba(255,255,255,0.5)'};`}
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</section>
