---
// Hero — full-viewport dark panel. Book cover del portfolio.
// Testo cream su graphite navy, signature 'designer.' in filigrana.
---
<section
  class="relative min-h-dvh bg-accent-deep text-on-accent flex flex-col overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- Signature "designer." in filigrana, dietro tutto — parallax al mouse -->
  <span
    id="heroSignature"
    aria-hidden="true"
    class="pointer-events-none select-none absolute -left-2 bottom-[16%] font-display italic font-light text-on-accent opacity-[0.06] leading-[0.85] tracking-tight whitespace-nowrap z-0 transition-transform duration-[600ms] ease-editorial"
    style="font-size: clamp(8rem, 26vw, 26rem); font-variation-settings: 'opsz' 144, 'SOFT' 100; will-change: transform;"
  >designer.</span>

  <!-- Top: chapter mark + eyebrow -->
  <div class="container-editorial pt-24 md:pt-28 relative z-10">
    <p class="flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.18em] font-medium text-on-accent/70 m-0" data-reveal>
      <span class="inline-block w-10 h-px bg-on-accent/60" aria-hidden="true"></span>
      <span class="tabular-nums">I</span>
      <span aria-hidden="true" class="opacity-40">—</span>
      <span>Portfolio · [Città] · luglio 2026</span>
    </p>
  </div>

  <!-- Middle: hero statement -->
  <div class="container-editorial flex-1 flex flex-col justify-center py-10 md:py-16 relative z-10">
    <h1
      id="hero-title"
      class="font-display font-normal leading-[1.02] tracking-tight m-0 mb-6 md:mb-8 max-w-[16ch] text-on-accent"
      data-reveal
      style="font-size: clamp(3.5rem, 10vw + 1rem, 8rem); font-variation-settings: 'opsz' 144, 'SOFT' 30; --reveal-delay: 1;"
    >
      Progetto <em class="italic font-light text-on-accent/85">sistemi</em>, non schermate.
    </h1>
    <p
      class="text-step-1 md:text-step-2 leading-[1.45] text-on-accent/75 max-w-[52ch] m-0"
      data-reveal
      style="--reveal-delay: 2;"
    >
      [Anni] anni tra prodotto e servizi digitali. Lavoro nel punto in cui la ricerca incontra le decisioni: framing dei problemi, sistemi di design, outcome misurabili. Sto spostando il mio focus verso ruoli di design strategy.
    </p>
  </div>

  <!-- Bottom: meta operativa + scroll indicator -->
  <div class="container-editorial pb-8 md:pb-10 relative z-10">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 pt-6 border-t border-on-accent/15"
      data-reveal
      style="--reveal-delay: 3;"
    >
      <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-step--1 text-on-accent/70" aria-label="Disponibilità e settori">
        <span><span class="text-on-accent/50 mr-1">◦</span>Disponibile da settembre</span>
        <span><span class="text-on-accent/50 mr-1">◦</span>Fintech · SaaS B2B · Servizi</span>
        <span><span class="text-on-accent/50 mr-1">◦</span>Remoto o Milano</span>
      </div>
      <a
        href="#work"
        class="hero-scroll group inline-flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.16em] font-medium text-on-accent/70 hover:text-on-accent no-underline self-start md:self-end"
        aria-label="Scorri per vedere i progetti"
      >
        <span>Scorri</span>
        <span
          aria-hidden="true"
          class="inline-flex items-center justify-center w-9 h-9 border border-on-accent/40 rounded-full transition-[border-color,transform] duration-300 ease-editorial group-hover:border-on-accent group-hover:translate-y-1"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M8 2v11M4 9l4 4 4-4"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Subtle bounce on the scroll arrow (respect reduced motion) */
  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }
  .hero-scroll span[aria-hidden] svg {
    animation: hero-bounce 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll span[aria-hidden] svg { animation: none; }
  }
</style>

<script>
  // Mouse parallax on the "designer." signature (subtle, editorial).
  // Fine pointer only (skips touch); respects prefers-reduced-motion.
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sig = document.getElementById('heroSignature');
  if (sig && finePointer && !reduce) {
    let raf: number | null = null;
    let tx = 0, ty = 0;
    const onMove = (e: MouseEvent) => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      // -1 to 1 range, damped
      tx = ((e.clientX / w) - 0.5) * 24; // 24px max drift horizontal
      ty = ((e.clientY / h) - 0.5) * 16;
      if (raf == null) {
        raf = requestAnimationFrame(() => {
          sig.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
          raf = null;
        });
      }
    };
    window.addEventListener('mousemove', onMove, { passive: true });
  }
</script>
