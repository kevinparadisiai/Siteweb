---
// Radial dashes graphic — Sketchin hero corner signature
const N = 28;
const cx = 200;
const cy = 200;
const rInner = 80;
const rOuter = 180;

const lines = Array.from({ length: N }, (_, i) => {
  const angle = (i * (Math.PI * 2 / N)) - Math.PI / 2;
  const rIn = rInner + (i % 3) * 8;
  const rOut = rOuter - (i % 4) * 6;
  return {
    x1: cx + Math.cos(angle) * rIn,
    y1: cy + Math.sin(angle) * rIn,
    x2: cx + Math.cos(angle) * rOut,
    y2: cy + Math.sin(angle) * rOut,
  };
});
---
<svg
  viewBox="0 0 400 400"
  class="signature-mark"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  {...Astro.props}
>
  {lines.map(({x1, y1, x2, y2}) => (
    <line
      x1={x1.toFixed(2)}
      y1={y1.toFixed(2)}
      x2={x2.toFixed(2)}
      y2={y2.toFixed(2)}
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
  ))}
</svg>
