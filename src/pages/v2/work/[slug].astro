---
import V2Base from '@/layouts/V2Base.astro';
import V2Header from '@/components/V2Header.astro';
import V2Footer from '@/components/V2Footer.astro';
import V2Eyebrow from '@/components/V2Eyebrow.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import { projects } from '@/data/projects';
import { engagements } from '@/data/engagements';

export async function getStaticPaths() {
  return projects.map((p, i) => {
    const next = projects[(i + 1) % projects.length];
    return { params: { slug: p.slug }, props: { project: p, next } };
  });
}

interface Props {
  project: typeof projects[number];
  next: typeof projects[number];
}
const { project, next } = Astro.props;
const engagement = engagements.find((e) => e.slug === project.slug);
const nextEngagement = engagements.find((e) => e.slug === next.slug);
const clientColor = engagement?.color ?? project.signatureColor;
const nextColor = nextEngagement?.color ?? next.signatureColor;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ghost = project.client.toLowerCase().replace(/\s+/g, '') + '.';
---
<V2Base title={`${project.client} — ${project.title}`} description={project.lede}>
  <V2Header current="work" />

  <main id="main">
    <!-- HERO CASE STUDY: ghost = nome cliente in lowercase, barra
         colore-cliente sotto il titolo, meta tecnica in mono. -->
    <section class="cs-hero" style={`--client:${clientColor};`}>
      <div class="cs-hero__ghost" aria-hidden="true">{ghost}</div>

      <div class="cs-hero__meta-block v2-shell">
        <V2Eyebrow>Case study · N.{project.num}</V2Eyebrow>
        <p class="cs-hero__meta mono">
          <span>{project.year}</span>
          <span aria-hidden="true">·</span>
          <span>{project.sector}</span>
          <span aria-hidden="true">·</span>
          <span>{engagement?.role ?? 'UX Designer'}</span>
        </p>
      </div>

      <div class="cs-hero__body v2-shell">
        <h1 class="cs-hero__title">{project.title}</h1>
        <span class="cs-hero__bar" aria-hidden="true"></span>
        <p class="cs-hero__lede">{project.lede}</p>
        <a href="#contesto" class="cs-hero__scroll mono" aria-label="Scorri al contesto">
          <span>Leggi il progetto</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <a href={`${base}/v2/`} class="cs-hero__back mono">
        <span aria-hidden="true">←</span>
        <span>Ledger</span>
      </a>
    </section>

    <!-- META STRIP tecnico -->
    <section class="cs-strip v2-shell">
      <dl class="cs-strip__dl">
        <div>
          <dt class="mono">Client</dt>
          <dd>
            <span class="cs-strip__swatch" style={`background:${clientColor};`} aria-hidden="true"></span>
            {project.client}
          </dd>
        </div>
        <div><dt class="mono">Sector</dt><dd>{project.sector}</dd></div>
        <div><dt class="mono">Year</dt><dd>{project.year}</dd></div>
        <div><dt class="mono">Role</dt><dd>{engagement?.role ?? 'UX Designer'}</dd></div>
        <div><dt class="mono">Services</dt><dd>{project.services.join(' · ')}</dd></div>
      </dl>
    </section>

    <!-- CONTESTO -->
    <section id="contesto" class="cs-block v2-shell">
      <V2Eyebrow>Contesto</V2Eyebrow>
      <div class="cs-block__body">
        {project.intro.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- RISULTATO -->
    <section class="cs-block v2-shell">
      <V2Eyebrow>Risultato</V2Eyebrow>
      <div class="cs-result__grid">
        <div class="cs-result__cell">
          <span class="cs-result__value">{project.metric.value}</span>
          <span class="cs-result__label">{project.metric.label}</span>
        </div>
        {project.metricsSecondary?.map((m) => (
          <div class="cs-result__cell cs-result__cell--sec">
            <span class="cs-result__value">{m.value}</span>
            <span class="cs-result__label">{m.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PROCESSO -->
    <section class="cs-block v2-shell">
      <V2Eyebrow>Processo</V2Eyebrow>
      <ol class="cs-phases">
        {project.phases.map((phase, i) => (
          <li class="cs-phase">
            <span class="cs-phase__num mono">
              <span class="cs-phase__num-mark" aria-hidden="true"></span>
              N.0{i + 1}
            </span>
            <div class="cs-phase__body">
              <h3 class="cs-phase__title">{phase.title}</h3>
              <p class="cs-phase__text">{phase.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- IL MIO RUOLO -->
    <section class="cs-block v2-shell">
      <V2Eyebrow>Il mio ruolo</V2Eyebrow>
      <div class="cs-block__body">
        <p>{project.role}</p>
      </div>
    </section>

    <!-- NEXT CASE -->
    <section class="cs-next v2-shell">
      <a href={`${base}/v2/work/${next.slug}/`} class="cs-next__link" style={`--next-color:${nextColor};`}>
        <span class="cs-next__eyebrow mono">— Next case</span>
        <span class="cs-next__title">
          <span class="cs-next__swatch" aria-hidden="true"></span>
          {next.client}
        </span>
        <span class="cs-next__arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <ContactBlock />
  <V2Footer />
</V2Base>

<style>
  /* ---------- HERO ---------- */
  .cs-hero {
    position: relative;
    min-height: min(80vh, 720px);
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 2rem) 5rem;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 2.5rem;
  }
  .cs-hero__ghost {
    position: absolute;
    top: clamp(4rem, 10vh, 8rem);
    left: clamp(-1rem, -2vw, -1.5rem);
    right: 0;
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(6rem, 22vw, 20rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
    color: color-mix(in srgb, var(--client) 12%, transparent);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }
  .cs-hero__meta-block {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .cs-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-2);
    letter-spacing: 0.02em;
    margin: 0;
  }
  .cs-hero__meta span[aria-hidden="true"] { opacity: 0.4; }

  .cs-hero__body {
    position: relative;
    z-index: 1;
    align-self: center;
    padding: 3rem 0 2rem;
    max-width: 40rem;
  }
  .cs-hero__title {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
    max-width: 16ch;
  }
  .cs-hero__bar {
    display: block;
    width: 5rem;
    height: 6px;
    background: var(--client);
    margin-top: 1.5rem;
  }
  .cs-hero__lede {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 46ch;
    margin: 1.5rem 0 2rem;
  }
  .cs-hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* touch-target ≥44px */
    min-height: 2.75rem;
    padding: 0 0.25rem;
    margin-left: -0.25rem;
    font-size: 0.82rem;
    color: var(--ink);
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--ink);
  }

  .cs-hero__back {
    position: absolute;
    top: 1.5rem;
    right: clamp(1.25rem, 4vw, 2rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* touch-target ≥44px */
    min-height: 2.75rem;
    padding: 0 0.25rem;
    font-size: 0.72rem;
    color: var(--ink-2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }
  .cs-hero__back:hover { color: var(--ink); }

  /* ---------- META STRIP ---------- */
  .cs-strip {
    padding: 2rem clamp(1.25rem, 4vw, 2rem) 3rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .cs-strip__dl {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    margin: 0;
  }
  .cs-strip__dl div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .cs-strip__dl dt {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cs-strip__dl dd {
    margin: 0;
    font-size: 0.98rem;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cs-strip__swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }
  @media (max-width: 780px) {
    .cs-strip__dl { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- BLOCKS ---------- */
  .cs-block {
    padding-top: 4rem;
    padding-bottom: 1rem;
    scroll-margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .cs-block__body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 62ch;
  }
  .cs-block__body p + p { margin-top: 1rem; }

  /* ---------- RESULT ---------- */
  .cs-result__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 3rem;
    padding: 1rem 0 2rem;
  }
  .cs-result__cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 4px solid var(--client);
  }
  .cs-result__cell--sec {
    border-top-color: color-mix(in srgb, var(--client) 55%, var(--ink) 45%);
  }
  .cs-result__value {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .cs-result__cell--sec .cs-result__value {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .cs-result__label {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 26ch;
  }

  /* ---------- PHASES ---------- */
  .cs-phases {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .cs-phase {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cs-phase:first-child { border-top: 1px solid var(--rule); }
  .cs-phase__num {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
    padding-top: 0.35rem;
    height: fit-content;
  }
  .cs-phase__num-mark {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--client);
  }
  .cs-phase__title {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 700;
    font-variation-settings: 'opsz' 48;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.2;
    margin: 0 0 0.5rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .cs-phase__text {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 62ch;
    margin: 0;
  }
  @media (max-width: 640px) {
    .cs-phase { grid-template-columns: 1fr; gap: 0.6rem; }
  }

  /* ---------- NEXT ---------- */
  .cs-next {
    padding-top: 5rem;
    padding-bottom: 2rem;
  }
  .cs-next__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    transition: padding-left 260ms cubic-bezier(0.2, 0.6, 0.2, 1),
                background-color 260ms ease;
  }
  .cs-next__link:hover {
    background-color: color-mix(in srgb, var(--next-color) 6%, transparent);
    padding-left: 1rem;
  }
  .cs-next__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cs-next__title {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .cs-next__swatch {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    background: var(--next-color);
    flex-shrink: 0;
  }
  .cs-next__arrow {
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    transition: transform 260ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .cs-next__link:hover .cs-next__arrow { transform: translateX(6px); }

  @media (max-width: 640px) {
    .cs-next__link { grid-template-columns: 1fr; gap: 0.75rem; padding: 2rem 0; }
    .cs-next__arrow { font-size: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-next__link,
    .cs-next__arrow { transition: none; }
    .cs-hero__back { transition: none; }
  }
</style>
