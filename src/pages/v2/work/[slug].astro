---
import V2Base from '@/layouts/V2Base.astro';
import V2Header from '@/components/V2Header.astro';
import V2Footer from '@/components/V2Footer.astro';
import { projects } from '@/data/projects';
import { engagements } from '@/data/engagements';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props {
  project: typeof projects[number];
}
const { project } = Astro.props;
const engagement = engagements.find((e) => e.slug === project.slug);
const clientColor = engagement?.color ?? project.signatureColor;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<V2Base title={`${project.client} — ${project.title}`} description={project.lede}>
  <V2Header current="work" />

  <main id="main">
    <!-- Riga-ledger ricopiata in cima come "breadcrumb" del progetto -->
    <div class="cs-top v2-shell">
      <a href={`${base}/v2/`} class="cs-back">
        <span aria-hidden="true">←</span> Torna al ledger
      </a>
    </div>

    <!-- Hero: nome cliente in Plex Condensed, colorato -->
    <header class="cs-hero v2-shell" style={`--client:${clientColor};`}>
      <div class="cs-hero__meta mono">
        <span>{project.year}</span>
        <span aria-hidden="true">·</span>
        <span>{project.sector}</span>
        <span aria-hidden="true">·</span>
        <span>{engagement?.role ?? 'UX Designer'}</span>
      </div>

      <h1 class="cs-hero__client">
        <span class="cs-hero__swatch" aria-hidden="true"></span>
        <span class="cs-hero__name">{project.client}</span>
      </h1>
      <span class="cs-hero__bar" aria-hidden="true"></span>

      <p class="cs-hero__lede">{project.lede}</p>
    </header>

    <!-- Deliverable + KPI in una griglia essenziale -->
    <section class="cs-block v2-shell" aria-labelledby="cs-context">
      <h2 id="cs-context" class="cs-block__label mono">Contesto</h2>
      <div class="cs-block__body">
        {project.intro.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="cs-kpi v2-shell" aria-labelledby="cs-kpi-label">
      <h2 id="cs-kpi-label" class="cs-block__label mono">Risultato</h2>
      <div class="cs-kpi__grid">
        <div class="cs-kpi__cell">
          <span class="cs-kpi__value">{project.metric.value}</span>
          <span class="cs-kpi__label">{project.metric.label}</span>
        </div>
        {project.metricsSecondary?.map((m) => (
          <div class="cs-kpi__cell cs-kpi__cell--sec">
            <span class="cs-kpi__value">{m.value}</span>
            <span class="cs-kpi__label">{m.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="cs-block v2-shell" aria-labelledby="cs-process">
      <h2 id="cs-process" class="cs-block__label mono">Processo</h2>
      <ol class="cs-phases">
        {project.phases.map((phase, i) => (
          <li class="cs-phase">
            <span class="cs-phase__num mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="cs-phase__body">
              <h3 class="cs-phase__title">{phase.title}</h3>
              <p class="cs-phase__text">{phase.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="cs-block v2-shell" aria-labelledby="cs-role">
      <h2 id="cs-role" class="cs-block__label mono">Il mio ruolo</h2>
      <div class="cs-block__body">
        <p>{project.role}</p>
      </div>
    </section>
  </main>

  <V2Footer />
</V2Base>

<style>
  .cs-top { padding-top: 1.5rem; padding-bottom: 0.5rem; }
  .cs-back {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.82rem;
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    /* touch-target-size ≥44px */
    min-height: 2.75rem;
    padding: 0 0.25rem;
    margin-left: -0.25rem;
    transition: color 180ms ease, transform 240ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .cs-back:hover { color: var(--ink); transform: translateX(-3px); }

  .cs-hero {
    padding-top: 3rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .cs-hero__meta {
    font-size: 0.82rem;
    color: var(--ink-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    letter-spacing: 0.02em;
  }
  .cs-hero__client {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(3.5rem, 12vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    /* Testo in --ink per contrasto AA (colori-cliente troppo chiari come
       Eni #F5D33A darebbero 1.4:1 — fail WCAG). Colore-cliente resta
       come marker semantico sullo swatch e sulla barra sotto. */
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cs-hero__swatch {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    background: var(--client);
    flex-shrink: 0;
  }
  .cs-hero__bar {
    display: block;
    width: 5rem;
    height: 6px;
    background: var(--client);
    margin-top: 1rem;
  }
  .cs-hero__lede {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.4;
    max-width: 52ch;
    color: var(--ink);
  }

  .cs-block {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
    padding: 3rem 1.25rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 720px) {
    .cs-block { padding: 3rem 2rem; }
  }
  .cs-block__label {
    font-size: 0.78rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
    padding-top: 0.35rem;
  }
  .cs-block__body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 66ch;
  }
  .cs-block__body p + p { margin-top: 1rem; }

  .cs-kpi { padding-top: 3rem; padding-bottom: 1rem; }
  .cs-kpi__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
    padding: 2rem 0;
  }
  .cs-kpi__cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cs-kpi__cell {
    /* Barra colore-cliente in testa al KPI: rispetta contrasto (colore
       solo su elemento visivo, non su testo). */
    position: relative;
    padding-top: 1rem;
    border-top: 4px solid var(--client);
  }
  .cs-kpi__value {
    font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .cs-kpi__label {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 26ch;
  }
  .cs-kpi__cell--sec {
    border-top-color: color-mix(in srgb, var(--client) 55%, var(--ink) 45%);
  }
  .cs-kpi__cell--sec .cs-kpi__value {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .cs-phases {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cs-phase {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cs-phase:last-child { border-bottom: none; }
  .cs-phase__num {
    font-size: 0.82rem;
    /* --client come testo piccolo può cadere sotto 4.5:1 (Eni gialla,
       CAP azzurra). Numero in --ink-2 (6.79:1), colore-cliente sposta
       su un marker leading (bullet) rispettoso di contrasto. */
    color: var(--ink-2);
    padding-top: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cs-phase__num::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--client);
    transform: translateY(1px);
  }
  .cs-phase__title {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .cs-phase__text {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 62ch;
  }

  @media (max-width: 720px) {
    .cs-block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 2rem 1.25rem;
    }
    .cs-block__label { padding-top: 0; }
  }
</style>
