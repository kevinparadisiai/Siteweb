---
import V2Base from '@/layouts/V2Base.astro';
import V2Header from '@/components/V2Header.astro';
import V2Footer from '@/components/V2Footer.astro';
import V2Eyebrow from '@/components/V2Eyebrow.astro';
import HeroPortrait from '@/components/HeroPortrait.astro';
import Ledger from '@/components/Ledger.astro';
import ContactBlock from '@/components/ContactBlock.astro';
---
<V2Base title="Kevin Paradisi — UX designer → Design strategy">
  <V2Header current="home" />

  <main id="main">
    <HeroPortrait />
    <div id="prove"><Ledger /></div>

    <!-- Note editoriale: prosa breve dopo la ledger. -->
    <section class="home-note v2-shell" aria-labelledby="note-title">
      <V2Eyebrow id="note-title">Note</V2Eyebrow>
      <div class="home-note__grid">
        <div class="home-note__body">
          <p class="home-note__lead">
            Dal 2018 lavoro dentro <strong>Assist Digital</strong>, in
            postazione consulente presso i clienti dell'elenco qui sopra.
          </p>
          <p>
            Il ruolo cambia nome — UX Designer, UX Consultant, Senior UX —
            ma il lavoro è sempre lo stesso: leggere il problema di business,
            capire chi ne paga il costo, e portare a terra la soluzione in
            cicli brevi con stakeholder che parlano lingue diverse.
          </p>
          <p>
            Il passaggio verso design strategy nasce da qui: la maggior
            parte delle decisioni che contano viene presa <em>prima</em>
            del wireframe, non dopo. La mia prossima quota è disegnare
            quel prima.
          </p>
        </div>
      </div>
    </section>
  </main>

  <ContactBlock />
  <V2Footer />
</V2Base>

<style>
  .home-note {
    padding-top: 5rem;
    padding-bottom: 3rem;
    scroll-margin-top: 2rem;
  }
  .home-note__grid {
    max-width: 62ch;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .home-note__body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .home-note__body p + p { margin-top: 1rem; }
  .home-note__body em { font-style: italic; font-weight: 500; }
  .home-note__body strong { font-weight: 600; }
  .home-note__lead {
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    line-height: 1.4;
    font-weight: 500;
  }
</style>
