---
import Base from '@/layouts/Base.astro';
import SiteSidebar from '@/components/SiteSidebar.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import FeatureHero from '@/components/FeatureHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Placeholder — sostituire con i dati reali quando disponibili.
// Esperienza — placeholder cronologico basato sui clienti dichiarati.
// Da rivedere con date/ruoli reali quando disponibili.
const experience = [
  { years: '2024 — oggi', role: 'Senior UX Designer',      company: 'TIM',            note: 'Self-caring digitale, KPI post-chiamata, coordinamento di un gruppo di designer.' },
  { years: '2022 — 2024', role: 'UX Designer',             company: 'Unipol',         note: '[Placeholder — sostituire con la sintesi reale del ruolo.]' },
  { years: '2021 — 2022', role: 'UX Designer',             company: 'Eolo',           note: '[Placeholder — sostituire con la sintesi reale del ruolo.]' },
  { years: '2020 — 2021', role: 'UX Designer',             company: 'Gruppo CAP',     note: "Redesign completo dell'area privata multi-profilo (10+ processi digitalizzati)." },
  { years: '2019 — 2020', role: 'UX Consultant',           company: 'Eni',            note: "Archivio storico digitale — 20+ pagine, migliaia di documenti indicizzati." },
  { years: '2018 — 2019', role: 'UX Consultant',           company: 'Lastminute.com', note: '[Placeholder — sostituire con la sintesi reale del ruolo.]' },
];

// Clienti reali con cui Kevin ha lavorato. Wordmark tipografici nei
// colori-brand come placeholder — riprodurre a mano le forme pittoriche
// dei loghi ufficiali (marchio, icona) violerebbe la loro identità, per
// questo restano wordmark neutri.
//
// Per usare i loghi reali: salvare gli SVG in `public/logos/{slug}.svg`
// e sostituire il <span> wordmark con:
//   <img src={`${base}/logos/${c.slug}.svg`} alt={c.name} class="client-logo" />
// hasLogo: true → render <img src="/logos/{slug}.{ext}">; false → wordmark
const clients = [
  { slug: 'lastminute', name: 'lastminute.com', sector: 'Travel',    color: '#EC008C', casing: 'lowercase' as const, hasLogo: true, ext: 'png' },
  { slug: 'eni',        name: 'eni',            sector: 'Energy',    color: '#F5C518', casing: 'lowercase' as const, hasLogo: true, ext: 'webp' },
  { slug: 'tim',        name: 'TIM',            sector: 'Telco',     color: '#0056A3', casing: 'uppercase' as const, hasLogo: true, ext: 'webp' },
  { slug: 'gruppo-cap', name: 'Gruppo CAP',     sector: 'Utilities', color: '#2892C7', casing: 'normal'    as const, hasLogo: true, ext: 'png'  },
  { slug: 'unipol',     name: 'Unipol',         sector: 'Insurance', color: '#007F3F', casing: 'normal'    as const, hasLogo: true, ext: 'svg'  },
  { slug: 'eolo',       name: 'eolo',           sector: 'Telco',     color: '#00A6E4', casing: 'lowercase' as const, hasLogo: true, ext: 'png'  },
];
const sectors = [
  'Energy & Utilities',
  'Telco',
  'Insurance',
  'Travel',
  'Fintech',
  'Cultura & Archivi',
];

const principi = [
  'Progetto da problema, non da mockup.',
  'Prototipo per decidere, non per illustrare.',
  'Metto le metriche prima del delivery.',
  'Sistemi, non schermate.',
  'La scrittura è artefatto di design.',
  'Non farei mai un design system senza governance.',
  'Preferisco decisioni tracciate a decisioni condivise.',
];
---
<Base title="About — Kevin Paradisi">
  <SiteSidebar slot="sidebar" current="about" />

  <FeatureHero
    crumb="Portfolio / About"
    glyph="K"
    title="Chi sono, e cosa penso del mestiere."
    titleEmWord="cosa penso"
    lede="Sette anni di UX tra prodotto e servizi digitali. Sposto il focus verso design strategy — dove il valore sta nel decidere cosa costruire, non nel disegnarlo tutto. Questa pagina è un placeholder in continua evoluzione."
  />

  <!-- Esperienza — timeline -->
  <section class="container-editorial py-16 md:py-24" aria-labelledby="esp-anchor">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16 mb-10">
      <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
        <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
        <span class="tabular-nums">I</span>
        <span aria-hidden="true" class="opacity-40">—</span>
        <span>Esperienza</span>
      </p>
      <h2
        id="esp-anchor"
        class="font-body font-bold text-fg m-0 max-w-[24ch]"
        style="font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;"
      >Dove ho lavorato, cosa ho posseduto.</h2>
    </div>

    <ol class="list-none p-0 m-0 flex flex-col">
      {experience.map((e, i) => (
        <li class:list={['grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_minmax(0,2fr)] gap-4 md:gap-10 items-baseline py-6 md:py-8', i < experience.length - 1 ? 'border-b border-border' : '']}>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-muted m-0 tabular-nums">{e.years}</p>
          <p class="font-body font-bold text-fg m-0 leading-tight" style="font-size: clamp(1.15rem, 1.6vw, 1.4rem);">
            {e.role}
            <span class="block font-normal text-muted mt-1 text-step-0">{e.company}</span>
          </p>
          <p class="text-step-0 text-fg leading-[1.5] m-0 max-w-[52ch]">{e.note}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Clienti: layout Sketchin "Our expertise" — big number a sinistra,
       grid di wordmark a destra. -->
  <section class="bg-bg border-y border-border py-20 md:py-28" aria-labelledby="loghi-anchor">
    <div class="container-editorial grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-16 items-start">

      <!-- LEFT — expertise -->
      <div>
        <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 mb-6 flex items-center gap-3">
          <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
          <span class="tabular-nums">II</span>
          <span aria-hidden="true" class="opacity-40">—</span>
          <span id="loghi-anchor">Clienti</span>
        </p>

        <p
          class="font-body font-black text-accent m-0 leading-none tabular-nums"
          style="font-size: clamp(5rem, 12vw, 10rem); letter-spacing: -0.045em;"
        >6</p>
        <p class="font-body text-step-1 text-fg m-0 mt-3 max-w-[26ch] leading-[1.35]">
          aziende enterprise con cui ho lavorato negli ultimi sette anni.
        </p>

        <p class="text-[0.72rem] uppercase tracking-[0.16em] font-medium text-muted m-0 mt-12 mb-4">
          Settori
        </p>
        <p class="font-body text-fg text-step-0 leading-[1.65] m-0 max-w-[40ch]">
          {sectors.map((s, i) => (
            <><span>{s}</span>{i < sectors.length - 1 ? <span class="text-muted mx-2" aria-hidden="true">·</span> : null}</>
          ))}
        </p>
      </div>

      <!-- RIGHT — client cells. Per-client flag `hasLogo` decides whether
           the SVG file at public/logos/{slug}.svg is rendered, or a
           brand-colored wordmark placeholder. -->
      <ul class="list-none p-0 m-0 grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-6">
        {clients.map((c) => (
          <li class="client-cell relative flex flex-col items-start justify-between p-6 min-h-[10rem] border border-border transition-colors duration-300 hover:border-fg">
            {c.hasLogo ? (
              <img
                src={`${base}/logos/${c.slug}.${c.ext}`}
                alt={c.name}
                class="client-logo max-h-[3.5rem] w-auto"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span
                class="client-wordmark font-body font-black"
                style={`color: ${c.color}; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -0.03em; line-height: 1; text-transform: ${c.casing === 'lowercase' ? 'lowercase' : c.casing === 'uppercase' ? 'uppercase' : 'none'};`}
              >{c.name}</span>
            )}
            <span class="font-mono text-[0.62rem] tracking-[0.16em] uppercase text-muted mt-4">
              {c.sector}
            </span>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- Principi (S14) -->
  <section class="container-editorial py-16 md:py-24" aria-labelledby="princ-anchor">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-8 md:gap-16 mb-10">
      <p class="text-[0.72rem] uppercase tracking-[0.18em] font-medium text-muted m-0 flex items-center gap-3">
        <span class="inline-block w-10 h-px bg-accent" aria-hidden="true"></span>
        <span class="tabular-nums">III</span>
        <span aria-hidden="true" class="opacity-40">—</span>
        <span>Principi</span>
      </p>
      <h2
        id="princ-anchor"
        class="font-body font-bold text-fg m-0 max-w-[24ch]"
        style="font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;"
      >Cosa credo del mestiere.</h2>
    </div>

    <ol class="list-none p-0 m-0 flex flex-col divide-y divide-border">
      {principi.map((p, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-5 items-baseline">
          <span class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <p class="font-body text-fg m-0" style="font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.35;">{p}</p>
        </li>
      ))}
    </ol>
  </section>

  <SiteFooter slot="footer" />
</Base>

<style>
  /* Client cell — subtle hover lift + tinted bg for the brand color */
  .client-cell {
    background: theme('colors.bg');
    transition: transform 320ms cubic-bezier(0.2, 0.6, 0.2, 1),
                border-color 320ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .client-cell:hover { transform: translateY(-2px); }
</style>
