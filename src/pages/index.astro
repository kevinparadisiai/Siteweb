---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteSidebar from '@/components/SiteSidebar.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Hero from '@/components/Hero.astro';
import Summary from '@/components/Summary.astro';
import WorkList from '@/components/WorkList.astro';
import LabList from '@/components/LabList.astro';
import Contact from '@/components/Contact.astro';
---
<Base title="[Nome Cognome] — UX Designer moving to strategy" bodyClass="">
  <SiteSidebar slot="sidebar" current="hero" />
  <SiteHeader slot="header" current="work" />

  <Hero />
  <Summary />
  <WorkList />
  <LabList />
  <Contact />

  <SiteFooter slot="footer" />
</Base>
