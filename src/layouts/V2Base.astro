---
// V2Base — layout auto-contenuto per la preview.
// Non usa global.css: definisce i propri token, il proprio pairing
// tipografico (Plex Condensed + Inter Tight + JetBrains Mono) e la
// propria palette (paper/ink + swatches cliente come dato, non come
// stile). Convive con il sito attuale senza toccarne una riga.
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Kevin Paradisi — UX designer che si sposta verso design strategy.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="it" class="v2">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* --- tokens v2 --- */
      html.v2 {
        --paper: #FBFBFA;
        --ink: #111111;
        --ink-2: #5A5A58;
        --rule: #DCDBD5;
        --flag: #E43C00;
        /* accento manifesto — ancorato al TIM blue (cliente attuale
           di Kevin, non decorativo). Usato solo sulla barra della
           "decisione" nell'hero. */
        --accent-manifesto: #1E39A0;

        color-scheme: light;
        background: var(--paper);
      }

      /* --- reset minimo --- */
      html.v2 *,
      html.v2 *::before,
      html.v2 *::after { box-sizing: border-box; }
      html.v2 body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter Tight', system-ui, -apple-system, sans-serif;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      html.v2 h1, html.v2 h2, html.v2 h3, html.v2 h4 {
        font-family: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
        font-weight: 700;
        font-variation-settings: 'opsz' 48;
        letter-spacing: -0.015em;
        margin: 0;
        color: var(--ink);
      }
      html.v2 p { margin: 0; }
      html.v2 a { color: inherit; text-decoration: none; }
      html.v2 a:focus-visible,
      html.v2 button:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
        border-radius: 1px;
      }
      html.v2 ::selection { background: var(--ink); color: var(--paper); }
      html.v2 img { max-width: 100%; display: block; }

      /* --- container --- */
      html.v2 .v2-shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      @media (min-width: 720px) {
        html.v2 .v2-shell { padding: 0 2rem; }
      }

      /* --- utility classes v2 --- */
      html.v2 .mono {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-variant-numeric: tabular-nums;
      }
      html.v2 .ink-2 { color: var(--ink-2); }
      html.v2 .flag  { color: var(--flag); }

      /* skip link a11y */
      html.v2 .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      html.v2 .skip-link:focus {
        left: 1rem;
        top: 1rem;
        background: var(--ink);
        color: var(--paper);
        padding: 0.5rem 0.75rem;
        z-index: 100;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot />
  </body>
</html>
