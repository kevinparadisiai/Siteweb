---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description = 'Portfolio di Kevin Paradisi — UX Designer moving to design strategy.', bodyClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,30;1,9..144,300..700,30&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />

    <script>
      // Scroll reveal — lightweight IntersectionObserver, respects reduced-motion.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in-view'));
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        // Legacy browser fallback: reveal all immediately.
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in-view'));
      }
    </script>
  </body>
</html>
