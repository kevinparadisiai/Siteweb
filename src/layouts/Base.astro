---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description = 'Portfolio di Kevin Paradisi — UX Designer moving to design strategy.', bodyClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,30;1,9..144,300..700,30&family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <slot name="sidebar" />
    <slot name="header" />

    <!-- Language switcher top-right (Sketchin persistent) -->
    <div class="lang-switch" aria-hidden="true">
      <span class="lang-switch__current">IT</span>
      <span class="lang-switch__sep">/</span>
      <span class="lang-switch__other">EN</span>
    </div>

    <main id="main"><slot /></main>
    <slot name="footer" />

    <!-- Custom cursor — mix-blend-difference adapts to any background -->
    <div id="cursor" class="site-cursor" aria-hidden="true">
      <div class="site-cursor__dot"></div>
      <div class="site-cursor__ring"></div>
      <div class="site-cursor__label" id="cursorLabel"></div>
    </div>

    <script>
      // ================= Scroll reveal =================
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in-view'));
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in-view'));
      }

      // ================= Custom cursor =================
      // Sketchin-style: dot follows mouse, grows to ring on interactive elements.
      // Skips touch devices and reduced-motion. Uses mix-blend-difference so
      // it reads on every background without knowing the color.
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const cursor = document.getElementById('cursor');
      const cursorLabel = document.getElementById('cursorLabel');

      if (cursor && finePointer && !reduce) {
        cursor.classList.add('is-enabled');
        let mx = -100, my = -100;
        let cx = -100, cy = -100;
        let raf: number | null = null;

        const loop = () => {
          // Lerp: smoothing factor 0.18 = tight follow
          cx += (mx - cx) * 0.22;
          cy += (my - cy) * 0.22;
          cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
          raf = requestAnimationFrame(loop);
        };

        document.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (raf == null) raf = requestAnimationFrame(loop);
        }, { passive: true });

        document.addEventListener('mouseleave', () => {
          cursor.classList.remove('is-visible');
        });
        document.addEventListener('mouseenter', () => {
          cursor.classList.add('is-visible');
        });

        // Delegated hover: any [data-cursor] element triggers scale
        const cursorHoverables = 'a, button, [role="button"], [data-cursor]';
        document.addEventListener('mouseover', (e) => {
          const target = (e.target as HTMLElement).closest(cursorHoverables);
          if (target) {
            cursor.classList.add('is-hovering');
            const label = target.getAttribute('data-cursor-label');
            if (label && cursorLabel) {
              cursorLabel.textContent = label;
              cursor.classList.add('has-label');
            }
          }
        });
        document.addEventListener('mouseout', (e) => {
          const target = (e.target as HTMLElement).closest(cursorHoverables);
          if (target) {
            cursor.classList.remove('is-hovering', 'has-label');
            if (cursorLabel) cursorLabel.textContent = '';
          }
        });
      }
    </script>
  </body>
</html>
